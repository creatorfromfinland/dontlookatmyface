        if data.Class == "MeshPart" and type(data.Mesh) == "string"
            and (data.Mesh:match("^rbxassetid://%d+$") or data.Mesh:match("^https?://www%.roblox%.com/asset/%?id=%d+$")) then
            part = assetService:CreateMeshPartAsync(Content.fromUri(data.Mesh))
            part.TextureID = type(data.Texture) == "string" and data.Texture or ""
        elseif data.Class == "Part" or data.Class == "WedgePart" or data.Class == "CornerWedgePart" then
            part = Instance.new(data.Class)
            if data.Class == "Part" and type(data.Shape) == "string" then part.Shape = Enum.PartType[data.Shape] end
        end
        if not part then return nil end
        copyProperties(part, partProperties, data.Properties)
        for _, appearance in ipairs(data.Appearance or {}) do
            local properties = appearanceProperties[appearance.Class]
            if properties then
                local child = Instance.new(appearance.Class)
                copyProperties(child, properties, appearance.Properties)
                child.Parent = part
            end
        end
