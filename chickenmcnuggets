            Name = "SnowHillBase",
            Size = Vector3.new(13.5 * scale, moundH, 13.5 * scale),
            Material = Enum.Material.Snow,
            Color = Color3.fromRGB(234, 243, 254),
            CFrame = CFrame.new(worldX, baseY - moundH * 0.22, worldZ),
