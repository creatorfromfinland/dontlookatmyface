    local function scanVisibleHudIcons(node, minY, inBackpack, origKnifeAssets, origGunAssets, knifeIcon, gunIcon)
        for _, child in ipairs(node:GetChildren()) do
            if child == gui then continue end
            if child:IsA("ScreenGui") then
                if not child.Enabled then continue end
            elseif child:IsA("GuiObject") then
                if not child.Visible or skipHudNames[child.Name] then continue end
                if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                    if inBackpack or child.AbsolutePosition.Y >= minY then
                        local saved = hudIconBackups[child]
                        local currentAsset = extractAssetId(saved or child.Image)
                        local replacement = (currentAsset and origKnifeAssets[currentAsset] and knifeIcon)
                            or (currentAsset and origGunAssets[currentAsset] and gunIcon)
                            or nil
                        if replacement then
                            if not saved then hudIconBackups[child] = child.Image end
                            if child.Image ~= replacement then child.Image = replacement end
                        elseif saved then
                            child.Image = saved
                            hudIconBackups[child] = nil
                        end
                    end
                end
            else
                continue
            end
            scanVisibleHudIcons(child, minY, inBackpack or child.Name == "Backpack", origKnifeAssets, origGunAssets, knifeIcon, gunIcon)
        end
    end

    local nextHudIconScan = 0
    local function updateWeaponIcons(character)
        local gunName = State.SkinGunHand ~= "Original" and State.SkinGunHand or State.GunSkin
        local knifeName = splitKnifeSelection(State.KnifeSkin)
        local gunIcon = weaponIconUri(gunName)
        local knifeIcon = weaponIconUri(knifeName)

        local origKnifeAssets, origGunAssets = {}, {}
        collectOrigIds(origKnifeAssets, player:GetAttribute("EquippedKnife"))
        collectOrigIds(origGunAssets, player:GetAttribute("EquippedGun"))

        for _, container in ipairs({player:FindFirstChildOfClass("Backpack"), character}) do
            if not container then continue end
            for _, tool in ipairs(container:GetChildren()) do
                local kind = isTool(tool, "Gun") and "Gun" or isTool(tool, "Knife") and "Knife"
                if not kind then continue end
                if toolIconBackups[tool] == nil then toolIconBackups[tool] = tool.TextureId end
                local itemId = tool:GetAttribute("ItemID")
                if kind == "Knife" then
                    collectOrigIds(origKnifeAssets, itemId, toolIconBackups[tool])
                else
                    collectOrigIds(origGunAssets, itemId, toolIconBackups[tool])
                end
                local targetIcon = kind == "Gun" and gunIcon or knifeIcon
                if targetIcon then
                    if tool.TextureId ~= targetIcon then tool.TextureId = targetIcon end
                elseif toolIconBackups[tool] ~= nil then
                    tool.TextureId = toolIconBackups[tool]
                    toolIconBackups[tool] = nil
                end
            end
        end

        for tool in pairs(toolIconBackups) do
            if not tool or not tool.Parent then toolIconBackups[tool] = nil end
        end

        if now() < nextHudIconScan then return end
        nextHudIconScan = now() + 0.45

        local cam = workspace.CurrentCamera
        local minY = cam and (cam.ViewportSize.Y * 0.65) or 0
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            scanVisibleHudIcons(playerGui, minY, false, origKnifeAssets, origGunAssets, knifeIcon, gunIcon)
        end
        pcall(function()
            local cg = game:GetService("CoreGui")
            local rg = cg and cg:FindFirstChild("RobloxGui")
            local bp = rg and rg:FindFirstChild("Backpack")
            if bp then
                scanVisibleHudIcons(bp, 0, true, origKnifeAssets, origGunAssets, knifeIcon, gunIcon)
            end
        end)

        for obj in pairs(hudIconBackups) do
            if not obj or not obj.Parent then hudIconBackups[obj] = nil end
        end
    end

