Instance.new("UICorner", search)

local function modelName(row)
    return row.id and (evoPhaseName(row.evo, row.phase) or (row.name .. " [" .. row.id .. "]")) or row.name
end
local function updateDetail()
    if not selected then detail:UpdateName("Select a skin"); return end
    local poses = WeaponPoseModels[modelName(selected)] or {}
    local available = {}
    for _, pose in ipairs(positions) do
        if poses[pose] then table.insert(available, pose) end
    end
    detail:UpdateName(selected.name .. " • " ..
        (#available > 0 and table.concat(available, " / ") or "Preview only"))
end
local function refreshCatalog()
    local rows, seen = {}, {}
    for _, row in ipairs(mmvCatalog) do
        local name = modelName(row)
        if not seen[name] then
            seen[name] = true
            table.insert(rows, row)
        end
    end
    for name, model in pairs(WeaponSkins) do
        if not seen[name] then table.insert(rows, {name = name, kind = model.Kind}) end
    end
    local query = search.Text:lower():match("^%s*(.-)%s*$")
    local matches = {}
    for _, row in ipairs(rows) do
        local name = modelName(row)
        if (kind == "All" or row.kind == kind) and name:lower():find(query, 1, true) then
            table.insert(matches, row)
        end
    end
    table.sort(matches, function(a, b)
        local availableA, availableB = WeaponSkins[modelName(a)] ~= nil, WeaponSkins[modelName(b)] ~= nil
        if availableA ~= availableB then return availableA end
        return modelName(a):lower() < modelName(b):lower()
    end)
    local pages = math.max(1, math.ceil(#matches / pageSize))
    page = math.clamp(page, 1, pages)
    for _, card in ipairs(grid:GetChildren()) do
        if card ~= layout then card:Destroy() end
    end
    for index = (page - 1) * pageSize + 1, math.min(page * pageSize, #matches) do
        local row = matches[index]
        local card = Instance.new("TextButton")
        card.Text = ""
        card.LayoutOrder = index
        card.BackgroundColor3 = selected and modelName(selected) == modelName(row) and Color3.fromRGB(62, 49, 93)
            or Color3.fromRGB(29, 28, 37)
        card.BorderSizePixel = 0
        card.Parent = grid
        Instance.new("UICorner", card)
        local icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size = UDim2.new(1, -10, 0, 56)
        icon.Position = UDim2.fromOffset(5, 3)
        icon.ScaleType = Enum.ScaleType.Fit
        local imageId = type(row.image) == "string" and row.image:match("[Aa]sset[Ii]d=(%d+)")
        if imageId then
            icon.Image = "rbxthumb://type=Asset&id=" .. imageId .. "&w=150&h=150"
        else
            local viewport = Instance.new("ViewportFrame")
            viewport.BackgroundTransparency = 1
            viewport.Size = icon.Size
            viewport.Position = icon.Position
            local world = Instance.new("WorldModel")
            world.Parent = viewport
            local model = Instance.new("Model")
            model.Parent = world
            if Runtime:BuildWeaponPreview(model, modelName(row)) then
                local frame, size = model:GetBoundingBox()
                local camera = Instance.new("Camera")
                camera.CFrame = CFrame.lookAt(frame.Position + Vector3.new(1, 0.6, 1) * math.max(size.Magnitude, 1), frame.Position)
                camera.Parent = viewport
                viewport.CurrentCamera = camera
                viewport.Parent = card
            else
                viewport:Destroy()
            end
        end
        icon.Parent = card
        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Position = UDim2.fromOffset(5, 58)
        label.Size = UDim2.new(1, -10, 0, 25)
        label.Text = row.name
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.TextSize = 11
        label.Font = Enum.Font.GothamMedium
        label.TextColor3 = WeaponSkins[modelName(row)] and accent or Color3.fromRGB(230, 226, 239)
        label.Parent = card
        card.Activated:Connect(function()
            selected = row
            updateDetail()
            refreshCatalog()
        end)
    end
    status:UpdateName(string.format("%d skins  •  %d / %d", #matches, page, pages))
end

local searchRevision = 0
Runtime:Connect(search:GetPropertyChangedSignal("Text"), function()
    searchRevision += 1
    local revision = searchRevision
    task.delay(0.14, function()
        if not Runtime.Alive or revision ~= searchRevision then return end
        page = 1
        refreshCatalog()
    end)
end)
filters:Dropdown({
    Name = "Weapon Type", Required = true, Default = 1, Options = {"All", "Knife", "Gun"},
    Callback = function(value)
        if value then kind, page = value, 1; refreshCatalog() end
    end,
})
filters:Dropdown({
    Name = "Model Position", Required = true, Default = 1, Options = positions,
    Callback = function(value) if value then position = value end end,
})
filters:Button({Name = "Apply Skin", Callback = function()
    if not selected then return end
    local name = modelName(selected)
    local poses = WeaponPoseModels[name]
    if not poses or not poses[position] then
        notify("Skin Catalog", "No " .. position .. " model for this skin.")
        return
    end
    local control
    if selected.kind == "Gun" then
        control = position == "Hand" and controls.SkinGunHand or position == "Belt" and controls.GunSkin
    else
        local flag = position == "Hand" and "burmalda_knife_skin" or "burmalda_knife_skin_" .. position:lower()
        control = MacLib.Options[flag]
    end
    if not control or not control:IsOption(name) then return end
    if selected.kind == "Knife" then
        controls.SkinKnifeHolster:UpdateSelection(position == "Hand" and "Original" or position)
    end
    controls["SkinChanger"]:UpdateState(true)
    control:UpdateSelection(name)
end})
filters:Button({Name = "Previous Page", Callback = function() page -= 1; refreshCatalog() end})
filters:Button({Name = "Next Page", Callback = function() page += 1; refreshCatalog() end})
local previousWeaponParsed = Runtime.OnWeaponParsed
local refreshPending = false
Runtime.OnWeaponParsed = function(weaponKind, name, pose)
    if previousWeaponParsed then previousWeaponParsed(weaponKind, name, pose) end
    if refreshPending then return end
    refreshPending = true
    task.delay(0.2, function()
        refreshPending = false
        if Runtime.Alive then updateDetail(); refreshCatalog() end
    end)
end
refreshCatalog()
catalogTab:Select()

end

