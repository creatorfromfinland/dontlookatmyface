local function resetThrownSkin(container)
        local record = thrownSkins[container]
        if not record then return end
        record.Active = false
        if record.FlightConn then record.FlightConn:Disconnect() end
        if record.CleanupConn then record.CleanupConn:Disconnect() end
        if record.EffectConn then record.EffectConn:Disconnect() end
        if record.HideConns then
            for _, conn in ipairs(record.HideConns) do conn:Disconnect() end
        end
        destroy(record.Skin)
        destroy(record.Attachment0)
        destroy(record.Attachment1)
        destroy(record.ParsedEffect)
        for obj, transparency in pairs(record.Hidden) do
            if obj.Parent then obj.LocalTransparencyModifier = transparency end
        end
        if record.HiddenTrans then
            for obj, transparency in pairs(record.HiddenTrans) do
                if obj.Parent then obj.Transparency = transparency end
            end
        end
        for obj, transparency in pairs(record.Decals) do
            if obj.Parent then obj.Transparency = transparency end
        end
        for obj, enabled in pairs(record.Effects) do
            if obj.Parent then obj.Enabled = enabled end
        end
        thrownSkins[container] = nil
    end

    restoreThrownSkins = function()
        for container in pairs(thrownSkins) do resetThrownSkin(container) end
    end

    local function hideThrownPart(obj, record)
        if not obj or not obj:IsA("BasePart") then return end
        if record.Hidden[obj] == nil then
            record.Hidden[obj] = obj.LocalTransparencyModifier
            record.HiddenTrans[obj] = obj.Transparency
            record.HideConns = record.HideConns or {}
            table.insert(record.HideConns, obj:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
                if record.Active and obj.Parent and obj.LocalTransparencyModifier ~= 1 then
                    obj.LocalTransparencyModifier = 1
                end
            end))
            table.insert(record.HideConns, obj:GetPropertyChangedSignal("Transparency"):Connect(function()
                if record.Active and obj.Parent and obj.Transparency ~= 1 then
                    obj.Transparency = 1
                end
            end))
        end
        if obj.LocalTransparencyModifier ~= 1 then obj.LocalTransparencyModifier = 1 end
        if obj.Transparency ~= 1 then obj.Transparency = 1 end
    end

    local function hideThrownObject(obj, record, replaceEffect)
        if record.Skin and obj:IsDescendantOf(record.Skin) then return end
        if record.Skin and obj:IsA("BasePart") then
            hideThrownPart(obj, record)
        elseif record.Skin and (obj:IsA("Decal") or obj:IsA("Texture")) then
            if record.Decals[obj] == nil then record.Decals[obj] = obj.Transparency end
            obj.Transparency = 1
        elseif replaceEffect then
            suppressWeaponEffect(obj, record)
        end
    end

    local function buildThrownSkin(knifeName, definition)
        local group = Instance.new("Folder")
        group.Name = "LarpChangerThrownSkin"

        local fit = knifeName and State.WeaponFits[knifeName]
        local scale = not knifeName and 1 or (fit and fit[1]) or (State.SkinScale / 0.03)
        local rawPieces = {}
        local reaverMeshes = {}

        local minB = Vector3.new(math.huge, math.huge, math.huge)
        local maxB = Vector3.new(-math.huge, -math.huge, -math.huge)

        for _, piece in ipairs(definition.Pieces) do
            if knifeName == "Reaver (Phase 1)" then
                local template = piece.Template
                local mesh = template:IsA("MeshPart") and template or template:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    local texture = mesh:IsA("MeshPart") and mesh.TextureID or mesh.TextureId
                    local key = mesh.MeshId .. "|" .. texture
                    if reaverMeshes[key] then continue end
                    reaverMeshes[key] = true
                end
            end

            local visual = piece.Template:Clone()
            visual.Name = "ThrownSkinPiece"
            visual.Size = visual.Size * scale
            local mesh = visual:FindFirstChildOfClass("SpecialMesh")
            if mesh and mesh.MeshType == Enum.MeshType.FileMesh then
                mesh.Scale *= scale
                mesh.Offset *= scale
            end

            local relative = piece.Relative.Rotation + piece.Relative.Position * scale
            if mesh and mesh.MeshType == Enum.MeshType.FileMesh and State.SkinMaterialOverride then
                local template = materialMesh(mesh)
                if template then
                    local replacement = template:Clone()
                    replacement.Name = visual.Name
                    replacement.Size = template.MeshSize * mesh.Scale
                    replacement.Color = visual.Color
                    replacement.Transparency = visual.Transparency
                    replacement.Reflectance = visual.Reflectance
                    replacement.TextureID = mesh.TextureId
                    relative *= CFrame.new(mesh.Offset)
                    visual:Destroy()
                    visual, mesh = replacement, nil
                end
            end

            visual.CanCollide = false
            visual.CanQuery = false
            visual.CanTouch = false
            visual.Massless = true
            visual.Anchored = true

            local recolor = usesWeaponColor("Knife")
            if not recolor and knifeName and knifeName:find("[TreeKnife2023Chroma]", 1, true)
                and visual:IsA("MeshPart") and visual.Material == Enum.Material.Neon and visual.TextureID == "" then
                nativeChromaParts[visual] = visual.Color:ToHSV()
            end
            if recolor or State.SkinMaterialOverride then
                if not State.SkinMaterialOverride or State.SkinMaterial ~= Enum.Material.ForceField then
                    if visual:IsA("MeshPart") then visual.TextureID = "" end
                    if mesh then mesh.TextureId = "" end
                end
                if mesh then mesh.VertexColor = Vector3.one end
                for _, child in ipairs(visual:GetChildren()) do
                    if child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture") then
                        child:Destroy()
                    end
                end
                if State.SkinMaterialOverride then
                    visual.MaterialVariant = ""
                    visual.Material = State.SkinMaterial
                end
                if recolor then
                    tintWeaponPart(visual, mesh, State.SkinChroma and chromaColor() or State.SkinColor)
                    if State.SkinChroma then chromaParts[visual] = mesh or false end
                end
            end

            local half = visual.Size * 0.5
            for _, sx in ipairs({-1, 1}) do
                for _, sy in ipairs({-1, 1}) do
                    for _, sz in ipairs({-1, 1}) do
                        local corner = relative:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
                        minB = Vector3.new(math.min(minB.X, corner.X), math.min(minB.Y, corner.Y), math.min(minB.Z, corner.Z))
                        maxB = Vector3.new(math.max(maxB.X, corner.X), math.max(maxB.Y, corner.Y), math.max(maxB.Z, corner.Z))
                    end
                end
            end

            visual.Parent = group
            table.insert(rawPieces, {Part = visual, Relative = relative})
        end

        if #rawPieces == 0 then
            group:Destroy()
            return nil
        end

        local center = (minB + maxB) * 0.5
        local extents = maxB - minB
        local baseOrient = CFrame.identity

        if extents.Z > extents.Y * 1.8 and extents.Z >= extents.X then
            baseOrient = CFrame.Angles(math.rad(90), 0, 0)
        elseif extents.X > extents.Y * 1.8 and extents.X > extents.Z * 1.8 then
            baseOrient = CFrame.Angles(0, 0, math.rad(90))
        end

        local pivot = Instance.new("Part")
        pivot.Name = "ThrowPivot"
        pivot.Size = Vector3.new(0.1, 0.1, 0.1)
        pivot.Transparency = 1
        pivot.Anchored = true
        pivot.CanCollide = false
        pivot.CanQuery = false
        pivot.CanTouch = false
        pivot.Massless = true
        pivot.Parent = group

        local pieces = {}
        local centerShift = CFrame.new(-center)
        for _, entry in ipairs(rawPieces) do
            table.insert(pieces, {
                Part = entry.Part,
                LocalFrame = baseOrient * centerShift * entry.Relative,
            })
        end

        group.Parent = pathFolder
        return group, pivot, pieces
    end

    local function trySkinThrownKnife(part)
        if not Runtime.Alive or not part or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then return end
        if part:IsDescendantOf(pathFolder) or part:FindFirstAncestorOfClass("Tool") or isInsideAnyCharacter(part) then return end
        if not hasLocalKnife() then return end

        local replaceEffect = State.WeaponEffect ~= "Original"
        for tracked, existing in pairs(thrownSkins) do
            if part == tracked or part:IsDescendantOf(tracked) then
                hideThrownObject(part, existing, replaceEffect)
                return
            end
        end

        local knifeName = splitKnifeSelection(State.KnifeSkin)
        local poses = State.SkinChanger and WeaponPoseModels[knifeName]
        local definition = poses and (poses.Belt or poses.Back or poses.Hand)
        local appearanceOnly = not definition and needsWeaponAppearance("Knife") and part.Archivable
        if not definition and not appearanceOnly and not replaceEffect then return end

        if next(localKnifeMeshIds) == nil then refreshLocalKnifeMeshes() end
        local mesh = part:IsA("MeshPart") and part or part:FindFirstChildOfClass("SpecialMesh")
        local id = mesh and meshAssetId(mesh.MeshId)
        local partName = part.Name:lower()
        local parentName = part.Parent and part.Parent.Name:lower() or ""
        local meshMatch = id ~= nil and localKnifeMeshIds[id] == true
        local nameMatch = partName:find("throwing", 1, true) ~= nil or parentName:find("throwing", 1, true) ~= nil
            or partName:find("thrown", 1, true) ~= nil or parentName:find("thrown", 1, true) ~= nil
        local nearLocalMatch = false
        if not meshMatch and not nameMatch and not part.CanCollide and part.Size.Magnitude < 12
            and (partName:find("knife", 1, true) ~= nil or parentName:find("knife", 1, true) ~= nil) then
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root and (part.Position - root.Position).Magnitude < 14 then
                nearLocalMatch = true
            end
        end
        if not (meshMatch or nameMatch or nearLocalMatch) then return end

        local container = part
        while container.Parent and container.Parent:IsA("BasePart") do
            container = container.Parent
        end
        local cParent = container.Parent
        local cParentName = cParent and cParent.Name:lower() or ""
        if cParent and cParent:IsA("Model") and cParent ~= workspace
            and (cParentName:find("knife", 1, true) ~= nil or cParentName:find("throw", 1, true) ~= nil) then
            container = cParent
        end

        if thrownSkins[container] then
            hideThrownObject(part, thrownSkins[container], replaceEffect)
            return
        end

        local record = {Active = true, Handle = part, Hidden = {}, HiddenTrans = {}, HideConns = {}, Decals = {}, Effects = {}}
        thrownSkins[container] = record

        local group, pivot, pieces
        if definition then
            group, pivot, pieces = buildThrownSkin(knifeName, definition)
        elseif appearanceOnly then
            local temporary = cloneWeaponAppearance(part)
            group, pivot, pieces = buildThrownSkin(nil, {
                Kind = "Knife",
                Pieces = {{Template = temporary, Relative = CFrame.identity}},
            })
            temporary:Destroy()
        end
        record.Skin = group

        local objects = container:GetDescendants()
        table.insert(objects, 1, container)
        for _, obj in ipairs(objects) do
            hideThrownObject(obj, record, replaceEffect)
        end

        record.EffectConn = container.DescendantAdded:Connect(function(child)
            if thrownSkins[container] == record then
                hideThrownObject(child, record, replaceEffect)
            end
        end)

        if replaceEffect then
            local effectAnchor = pivot or part
            mountWeaponEffect(effectAnchor, "Knife", record, State.WeaponEffect)
        end

if pivot and pieces then
            local spawnPos = part.Position
            local lastMovedPos = spawnPos
            local lastMovedTime = os.clock()
            local initVel = part.AssemblyLinearVelocity
            local hasRealDir = initVel.Magnitude > 5
            local flightDir
            if hasRealDir then
                flightDir = initVel.Unit
            else
                local cam = workspace.CurrentCamera
                local camLook = cam and cam.CFrame.LookVector or part.CFrame.LookVector
                local mouseHit = player:GetMouse().Hit
                local toMouse = mouseHit and (mouseHit.Position - spawnPos)
                if toMouse and toMouse.Magnitude > 2 and toMouse.Unit:Dot(camLook) > 0.35 then
                    flightDir = toMouse.Unit
                else
                    flightDir = camLook
                end
            end

            local wasUnanchored = not part.Anchored
            local initJoints = #part:GetJoints()
            local spinAngle = math.rad(-25)
            local stuck = false
            local stuckTime = 0
            local stickStartAngle = 0
            local targetStickAngle = 0

            local function lockStuck()
                if stuck then return end
                stuck = true
                stuckTime = 0
                local desiredPhase = math.rad(90)
                local turns = math.round((spinAngle - desiredPhase) / (math.pi * 2))
                targetStickAngle = desiredPhase + turns * math.pi * 2
                stickStartAngle = spinAngle
            end

            local function applyThrowPose(cf)
                pivot.CFrame = cf
                for _, entry in ipairs(pieces) do
                    if entry.Part.Parent then
                        entry.Part.CFrame = cf * entry.LocalFrame
                    end
                end
            end

            local upInit = math.abs(flightDir.Y) > 0.97 and Vector3.xAxis or Vector3.yAxis
            applyThrowPose(CFrame.lookAt(spawnPos, spawnPos + flightDir, upInit) * CFrame.Angles(-spinAngle, 0, 0))

            record.FlightConn = RunService.RenderStepped:Connect(function(dt)
                if not Runtime.Alive or not record.Active or not part.Parent or not pivot.Parent then
                    resetThrownSkin(container)
                    return
                end

                local nowClock = os.clock()
                local curPos = part.Position
                local stepDelta = curPos - lastMovedPos
                local stepDist = stepDelta.Magnitude
                local vel = part.AssemblyLinearVelocity

                if not part.Anchored then
                    wasUnanchored = true
                end

                local justAnchored = wasUnanchored and part.Anchored
                local weldedToHit = #part:GetJoints() > initJoints

                if stepDist > 0.04 then
                    local stepDir = stepDelta.Unit
                    local fromSpawn = curPos - spawnPos
                    if not hasRealDir and fromSpawn.Magnitude > 0.25 then
                        flightDir = fromSpawn.Unit
                        hasRealDir = true
                    elseif hasRealDir and not stuck and stepDir:Dot(flightDir) > 0.85 then
                        flightDir = flightDir:Lerp(stepDir, math.min(1, dt * 18)).Unit
                    end
                    lastMovedPos = curPos
                    lastMovedTime = nowClock
                    if stuck and not justAnchored and not weldedToHit and stepDist > 0.12 then
                        stuck = false
                    end
                elseif vel.Magnitude > 8 and not part.Anchored then
                    lastMovedTime = nowClock
                    if not hasRealDir then
                        flightDir = vel.Unit
                        hasRealDir = true
                    elseif not stuck and vel.Unit:Dot(flightDir) > 0.85 then
                        flightDir = flightDir:Lerp(vel.Unit, math.min(1, dt * 18)).Unit
                    end
                end

                if not stuck then
                    if justAnchored or weldedToHit or (nowClock - lastMovedTime) >= 0.08 then
                        lockStuck()
                    else
                        spinAngle += dt * math.rad(1150)
                    end
                end

                local upRef = math.abs(flightDir.Y) > 0.97 and Vector3.xAxis or Vector3.yAxis
                local flightCFrame = CFrame.lookAt(curPos, curPos + flightDir, upRef)
                local finalCF
                if not stuck then
                    finalCF = flightCFrame * CFrame.Angles(-spinAngle, 0, 0)
                else
                    stuckTime += dt
                    local alpha = math.min(1, stuckTime / 0.04)
                    local eased = 1 - (1 - alpha) ^ 3
                    local vib = math.sin(stuckTime * 62) * math.exp(-stuckTime * 26) * math.rad(4)
                    local curAngle = stickStartAngle + (targetStickAngle - stickStartAngle) * eased + vib
                    finalCF = flightCFrame * CFrame.Angles(-curAngle, 0, 0)
                end

                applyThrowPose(finalCF)
            end)
        end

        record.CleanupConn = container.AncestryChanged:Connect(function()
            if not container:IsDescendantOf(workspace) then
                resetThrownSkin(container)
            end
        end)
    end

    Runtime:Connect(workspace.DescendantAdded, function(desc)
        if not Runtime.Alive then return end
        if not State.SkinChanger and State.WeaponEffect == "Original" and not needsWeaponAppearance("Knife") then return end
        if desc:IsA("BasePart") then
            trySkinThrownKnife(desc)
            task.defer(trySkinThrownKnife, desc)
        elseif desc:IsA("SpecialMesh") and desc.Parent and desc.Parent:IsA("BasePart") then
            trySkinThrownKnife(desc.Parent)
            task.defer(trySkinThrownKnife, desc.Parent)
        end
    end)

function Runtime:Set(key, value)
    if not self.Alive or State[key] == value then return end
    State[key] = value
    if key ~= "DumpEnabled" then restoreSkins() end
    if self.OnState then self.OnState(key, value) end
end
function Runtime:Destroy()
    if not self.Alive then return end
    self:FlushWeaponArchive()
    self:FlushEffectArchive()
    self.Alive = false
pcall(RunService.UnbindFromRenderStep, RunService, "LarpChangerSkinSync")
    disconnectCharacterHooks()
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
    restoreSkins()
    for _, object in ipairs(self.Owned) do destroy(object) end
    if environment.LarpChangerSkinDumper == self then environment.LarpChangerSkinDumper = nil end
    window:Unload()
end
