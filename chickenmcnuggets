--// Library Functions
local ClassParser = {
	["Toggle"] = {
		Save = function(Flag, data)
			return {
				type = "Toggle", 
				flag = Flag, 
				state = data.State or false
			}
		end,
		Load = function(Flag, data)
			if MacLib.Options[Flag] and type(data.state) == "boolean" then
				MacLib.Options[Flag]:UpdateState(data.state)
			end
		end
	},
	["Slider"] = {
		Save = function(Flag, data)
			return {
				type = "Slider", 
				flag = Flag, 
				value = (data.Value and tostring(data.Value)) or false
			}
		end,
		Load = function(Flag, data)
			if MacLib.Options[Flag] and data.value then
				MacLib.Options[Flag]:UpdateValue(data.value)
			end
		end
	},
	["Input"] = {
		Save = function(Flag, data)
			return {
				type = "Input", 
				flag = Flag, 
				text = data.Text
			}
		end,
		Load = function(Flag, data)
			if MacLib.Options[Flag] and data.text and type(data.text) == "string" then
				MacLib.Options[Flag]:UpdateText(data.text)
			end
		end
	},
	["Keybind"] = {
		Save = function(Flag, data)
			return {
				type = "Keybind", 
				flag = Flag, 
				bind = data:GetBind() and data:GetBind().Name or "None"
			}
		end,
		Load = function(Flag, data)
			if MacLib.Options[Flag] and data.bind then
				local control = MacLib.Options[Flag]
				if data.bind == "None" then
					if control.Settings.AllowUnbind then control:Bind(nil) end
				else
					for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
						if item.Name == data.bind then control:Bind(item); return end
					end
					if not control.Settings.KeyboardOnly and (data.bind == "MouseButton1" or data.bind == "MouseButton2") then
						control:Bind(Enum.UserInputType[data.bind])
					end
				end
			end
		end
	},
	["Dropdown"] = {
		Save = function(Flag, data)
			return {
				type = "Dropdown", 
				flag = Flag, 
				value = data.PendingSelection or data.Value
			}
		end,
		Load = function(Flag, data)
			if MacLib.Options[Flag] and data.value then
				local control = MacLib.Options[Flag]
				local selected = type(data.value) == "table" and data.value[1] or data.value
				if control:IsOption(selected) then
					control:UpdateSelection(selected)
				elseif control.LoadUnavailable then
					control:LoadUnavailable(selected)
				end
			end
		end
	},
	["Colorpicker"] = {
		Save = function(Flag, data)
			local function Color3ToHex(color)
				return string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
			end

			return {
				type = "Colorpicker", 
				flag = Flag, 
				color = Color3ToHex(data.Color) or nil,
				alpha = data.Alpha
			}
		end,
		Load = function(Flag, data)
			local function HexToColor3(hex)
				local r = tonumber(hex:sub(2, 3), 16)
				local g = tonumber(hex:sub(4, 5), 16)
				local b = tonumber(hex:sub(6, 7), 16)
				if r and g and b then return Color3.fromRGB(r, g, b) end
				return nil
			end

			if MacLib.Options[Flag] and data.color then
				local color = type(data.color) == "string" and HexToColor3(data.color)
				if not color then return end
				MacLib.Options[Flag]:SetColor(color) 
				if data.alpha then
					MacLib.Options[Flag]:SetAlpha(data.alpha)
				end
			end
		end
	}
}

local function BuildFolderTree()
	if isStudio or not (isfolder and makefolder) then return "Config system unavailable." end

	local paths = {
		MacLib.Folder,
		MacLib.Folder .. "/settings"
	}

	for i = 1, #paths do
		local str = paths[i]
		if not isfolder(str) then
			makefolder(str)
		end
	end
	return nil
end

function MacLib:SetFolder(Folder)
	if isStudio then return "Config system unavailable." end

	MacLib.Folder = Folder;
	BuildFolderTree()
	return nil
end

function MacLib:SaveConfig(Path, includeFlag)
	if isStudio or not writefile then return "Config system unavailable." end

	if (not Path) then
		return false, "Please select a config file."
	end

	local fullPath = MacLib.Folder .. "/settings/" .. Path .. ".json"

	local data = {
		objects = {}
	}

	for flag, option in next, MacLib.Options do
		if not ClassParser[option.Class] then continue end
		if option.IgnoreConfig or (includeFlag and not includeFlag(flag)) then continue end

		table.insert(data.objects, ClassParser[option.Class].Save(flag, option))
	end	

	local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
	if not success then
		return false, "Unable to encode into JSON data"
	end

	writefile(fullPath, encoded)
	return true
end

function MacLib:LoadConfig(Path, legacy, includeFlag)
	if isStudio or not (isfile and readfile) then return "Config system unavailable." end

	if (not Path) then
		return false, "Please select a config file."
	end

	local file = legacy and ("BurmaldaLuna/settings/" .. Path .. ".luna") or (MacLib.Folder .. "/settings/" .. Path .. ".json")
	if not isfile(file) then return false, "Invalid file" end

	local success, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(file))
	if not success or type(decoded) ~= "table" or type(decoded.objects) ~= "table" then
		return false, "Unable to decode JSON data."
	end

	for _, option in next, decoded.objects do
		local control = type(option) == "table" and MacLib.Options[option.flag]
		if control and not control.IgnoreConfig and (not includeFlag or includeFlag(option.flag)) and control.Class == option.type and ClassParser[option.type] then
			local ok, err = pcall(ClassParser[option.type].Load, option.flag, option)
			if not ok then warn("LarpChanger config " .. option.flag .. ": " .. tostring(err)) end
		end
	end

	return true
end

function MacLib:RefreshConfigList()
	if isStudio or not (isfolder and listfiles) then return "Config system unavailable." end

	local list = (isfolder(MacLib.Folder) and isfolder(MacLib.Folder .. "/settings")) and listfiles(MacLib.Folder .. "/settings") or {}

	local out = {}
	for i = 1, #list do
		local file = list[i]
		if file:sub(-5) == ".json" then
			local pos = file:find(".json", 1, true)
			local start = pos

			local char = file:sub(pos, pos)
			while char ~= "/" and char ~= "\\" and char ~= "" do
				pos = pos - 1
				char = file:sub(pos, pos)
			end

			if char == "/" or char == "\\" then
				local name = file:sub(pos + 1, start - 1)
				if name ~= "options" then
					table.insert(out, name)
				end
			end
		end
	end

	return out
end

