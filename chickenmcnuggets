    local function saveCapturedWeapon(name, rarity, pose)
        if not canArchive then return end
        local key = name .. "::" .. pose
        if archive[key] then return end
        local model = WeaponPoseModels[name][pose]
        local saved = {Kind = model.Kind, Rarity = rarity, Signature = model.Signature,
            FullGrip = model.FullGrip, Pieces = {}}
        if model.SourceGrip then saved.SourceGrip = {model.SourceGrip:GetComponents()} end
        if model.BeltFrame then
