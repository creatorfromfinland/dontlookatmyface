        local starY = spireY + spireH * 0.58
        local starSz = Vector3.new(2.1 * scale, 2.1 * scale, 0.48 * scale)
        local starA = makePart("Part", {
            Name = "FestiveStarA",
            Size = starSz,
            Material = Enum.Material.Neon,
            Color = Color3.fromRGB(255, 226, 95),
            CFrame = CFrame.new(worldX, starY, worldZ) * CFrame.Angles(0, 0, math.rad(45)),
        })
        makePart("Part", {
            Name = "FestiveStarB",
            Size = starSz,
            Material = Enum.Material.Neon,
            Color = Color3.fromRGB(255, 226, 95),
            CFrame = CFrame.new(worldX, starY, worldZ) * CFrame.Angles(0, math.rad(90), math.rad(45)),
