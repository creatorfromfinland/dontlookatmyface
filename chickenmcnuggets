    local function extractAssetId(uri)
        if type(uri) == "number" then uri = tostring(uri) end
        if type(uri) ~= "string" then return nil end
        return uri:match("[Aa]sset[Ii]d=(%d+)") or uri:match("[?&][Ii][Dd]=(%d+)") or uri:match("rbxassetid://(%d+)") or uri:match("^(%d+)$")
    end

    local function resolveWeaponItemId(name)
        if type(name) ~= "string" or name == "Original" then return nil end
        local id = name:match("%[([%w_-]+)%]$")
        if id then return id end
        local base, phase = name:match("^(.-) %(Phase ([1-4])%)$")
        if base and phase then
            local index = tonumber(phase)
            for family, title in pairs(EvoNames) do
                if title == base then
                    return index == 1 and family or (family .. "_" .. EvoPhaseRarity[index])
                end
            end
        end
        return nil
    end

    local function weaponIconUri(name)
        local id = resolveWeaponItemId(name)
        if not id then return nil end
        if KnownWeaponIcons[id] then return KnownWeaponIcons[id] end
        if not itemCatalog then
            local database = Storage:FindFirstChild("Database")
            local sync = database and database:FindFirstChild("Sync")
            local items = sync and sync:FindFirstChild("Item")
            if items and items:IsA("ModuleScript") then
                local ok, data = pcall(require, items)
                if ok and type(data) == "table" then itemCatalog = data end
            end
        end
        local entry = itemCatalog and itemCatalog[id]
        local raw = entry and (entry.Image or entry.ItemImage)
        local assetId = extractAssetId(raw)
        if assetId then
            return "rbxthumb://type=Asset&id=" .. assetId .. "&w=150&h=150"
        end
        return nil
    end

    local function collectOrigIds(set, itemId, extraUri)
        local a = extractAssetId(extraUri)
        if a then set[a] = true end
        if itemId then
            local k = extractAssetId(KnownWeaponIcons[itemId])
            if k then set[k] = true end
            local entry = itemCatalog and itemCatalog[itemId]
            local e = entry and extractAssetId(entry.Image or entry.ItemImage)
            if e then set[e] = true end
        end
    end

