    if isFestive then
        if lightAnchor then
            local glow = Instance.new("PointLight")
            glow.Color = Color3.fromRGB(255, 215, 145)
            glow.Brightness = 1.4
            glow.Range = 36
            glow.Shadows = false
            glow.Parent = lightAnchor
