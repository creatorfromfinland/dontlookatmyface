local lastCamPos = Vector3.zero
local indoorsSince = nil

table.insert(connections, RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local camPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 0.01 then
        flatLook = flatLook.Unit
    else
        flatLook = Vector3.zero
    end

    for _, layer in ipairs(snowLayers) do
        local pos = camPos + (flatLook * layer.ForwardOffset) + Vector3.new(0, layer.HeightOffset, 0)
        layer.Part.CFrame = CFrame.new(pos)
    end

    local jumped = (camPos - lastCamPos).Magnitude > 14
    lastCamPos = camPos

    local now = os.clock()
    if jumped or (now - lastCheckTime) >= 0.12 then
        lastCheckTime = now
        local outdoors = isCameraOutdoors(camPos)

        if outdoors then
            indoorsSince = nil
            setSnowEnabled(true)
        else
            setSnowEnabled(false)
            if jumped then
                clearSnowParticles()
                indoorsSince = now
            else
                if not indoorsSince then
                    indoorsSince = now
                elseif (now - indoorsSince) >= 0.22 then
                    clearSnowParticles()
                end
            end
        end
    end
end))

