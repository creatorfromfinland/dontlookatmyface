    local function captureWeaponEffects(tool, handle, equippedEffect)
        local effectId = tool:GetAttribute("EffectID") or tool:GetAttribute("EquippedEffect") or equippedEffect
        local entry = effectId and effectCatalog[effectId]
        local title = type(entry) == "table" and (entry.ItemName or entry.Name)
        if type(title) ~= "string" or title == "" then title = nil end
        if title and parsedEffectIds[effectId] then return false end
        local effects = {}
        local signature = {}
        local mounted = skins[tool]
        for _, source in ipairs(tool:GetDescendants()) do
            local emitter = source:IsA("ParticleEmitter")
            if not (emitter or source:IsA("Trail") or source:IsA("Beam")) or not source.Archivable then continue end
            if mounted and (source.Parent == mounted.Attachment0 or source.Parent == mounted.Attachment1
                or (mounted.ParsedEffect and source:IsDescendantOf(mounted.ParsedEffect))) then continue end
            local first, second
            if emitter then
                local parent = source.Parent
                if parent:IsA("Attachment") then
                    first = handle.CFrame:ToObjectSpace(parent.WorldCFrame)
                elseif parent:IsA("BasePart") then
                    first = handle.CFrame:ToObjectSpace(parent.CFrame)
                end
            else
                local a, b = source.Attachment0, source.Attachment1
                if a and b and a:IsDescendantOf(tool) and b:IsDescendantOf(tool) then
                    first = handle.CFrame:ToObjectSpace(a.WorldCFrame)
                    second = handle.CFrame:ToObjectSpace(b.WorldCFrame)
                end
            end
            if not first then continue end
            table.insert(effects, {Source = source, First = first, Second = second})
            local texture = meshAssetId(source.Texture) or source.Texture
            table.insert(signature, table.concat({source.ClassName, source.Name, texture}, ":"))
        end
        if #effects == 0 then return false end
        table.sort(signature)
        local key = table.concat(signature, "|")
        local name, previous
        for savedName, record in pairs(effectArchive) do
            if record.Version ~= effectArchiveVersion
                and ((title and record.Id == effectId) or (not title and record.Shape == key)) then
                name, previous = savedName, ParsedWeaponEffects[savedName]
                break
            end
        end
        if name then
            if previous then
                for _, effect in ipairs(previous) do effect.Template:Destroy() end
            end
        elseif title then
            name = "MM2: " .. title
            if ParsedWeaponEffects[name] then name = name .. " [" .. tostring(effectId) .. "]" end
        else
            if parsedEffectShapes[key] then return false end
            unknownEffectNumber += 1
            name = "MM2: Unidentified effect #" .. unknownEffectNumber
        end
        for _, effect in ipairs(effects) do
            local template = effect.Source:Clone()
            template:ClearAllChildren()
            if not template:IsA("ParticleEmitter") then template.Attachment0, template.Attachment1 = nil, nil end
            template.Parent = modelTemplates
            effect.Template, effect.Source = template, nil
        end
        ParsedWeaponEffects[name] = effects
        parsedEffectShapes[key] = true
        if title then parsedEffectIds[effectId] = true end
        archiveEffect(name, effects, title and effectId or nil, key)
        if State.WeaponEffect == name then restoreSkins() end
        if not previous and Runtime.OnWeaponEffectParsed then Runtime.OnWeaponEffectParsed(name) end
        return true
    end
    local function captureWeapon(tool, handle, kind, name, pose, originalGrip, belt)
        if WeaponPoseModels[name] and WeaponPoseModels[name][pose] then return false end
        local sourceGrip = originalGrip and originalGrip:Inverse() or CFrame.identity
        local pieces = {}
        local meshIds = {}
        local mountedSkin = skins[tool] and skins[tool].Skin
        local sources = tool:GetDescendants()
        if tool:IsA("BasePart") then table.insert(sources, 1, tool) end
        for _, source in ipairs(sources) do
            if source:IsA("BasePart") and source.Archivable and source.Transparency < 1
                and not (mountedSkin and source:IsDescendantOf(mountedSkin)) then
                local visual = cloneWeaponAppearance(source)
                local mesh = visual:IsA("MeshPart") and visual or visual:FindFirstChildOfClass("SpecialMesh")
                local uri = mesh and mesh.MeshId
                local id = meshAssetId(uri)
                if id then meshIds[id] = true end
                visual.Parent = modelTemplates
                table.insert(pieces, {Template = visual, Relative = sourceGrip * handle.CFrame:ToObjectSpace(source.CFrame)})
            end
        end
        local ids = {}
        for id in pairs(meshIds) do table.insert(ids, id) end
        table.sort(ids)
        local signature = table.concat(ids, ",")
        if #pieces == 0 then return false end
        if signature == "" then signature = "parts:" .. name end
        registerWeaponPose(name, pose, {Kind = kind, Pieces = pieces, Signature = signature,
            FullGrip = originalGrip ~= nil, SourceGrip = originalGrip,
            BeltFrame = belt and belt.WorldCFrame:ToObjectSpace(handle.CFrame),
            BeltAttachment = belt and belt.Name})
        return true
    end

    function Runtime:ScanOfficialWeapons()
        if not self.Alive then return end
        if not itemCatalog then
            local database = Storage:FindFirstChild("Database")
            local sync = database and database:FindFirstChild("Sync")
            local items = sync and sync:FindFirstChild("Item")
            if not items or not items:IsA("ModuleScript") then return end
            local ok, data = pcall(require, items)
            if not ok or type(data) ~= "table" then return end
            itemCatalog = data
            local module = sync:FindFirstChild("Effects")
            if module and module:IsA("ModuleScript") then
                local loaded, effects = pcall(require, module)
                if loaded and type(effects) == "table" then effectCatalog = effects end
            end
        end
        local seen = {}
        local newCount = 0
        local newEffects = 0
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            local character = otherPlayer.Character
            for _, kind in ipairs({"Knife", "Gun"}) do
                local display = displayedWeapon(character, kind)
                if not display then continue end
                local mesh = display:IsA("MeshPart") and display or display:FindFirstChildOfClass("SpecialMesh")
                local id = mesh and meshAssetId(mesh.MeshId)
                if not id then continue end
                local texture = meshAssetId(mesh:IsA("MeshPart") and mesh.TextureID or mesh.TextureId)
                local itemId = otherPlayer:GetAttribute("Equipped" .. kind)
                local entry = itemId and itemCatalog[itemId]
                local name = kind .. " Display [" .. id .. (texture and "-" .. texture or "") .. "]"
                local rarity
                if entry and entry.ItemType == kind then
                    name = evoPhaseName(entry.EvoBaseID, entry.EvoIndex) or (entry.ItemName .. " [" .. tostring(itemId) .. "]")
                    rarity = entry.Rarity
                end
                if captureWeaponEffects(display, display, otherPlayer:GetAttribute("EquippedEffect")) then newEffects += 1 end
                local belt = weaponAttachment(character, kind, display)
                local pose = belt and (belt.Name == "KnifeBack" and "Back" or "Belt")
                if pose and captureWeapon(display, display, kind, name, pose, nil, belt) then
                    capturedPlayerWeapons[name .. "::" .. pose] = true
                    newCount += 1
                    saveCapturedWeapon(name, rarity, pose)
                end
                if pose then seen[name .. "::" .. pose] = true end
            end
            for _, container in pairs({character, otherPlayer:FindFirstChildOfClass("Backpack")}) do
                for _, source in ipairs(container:GetDescendants()) do
                    if not (source:IsA("Tool") or source:IsA("Model") or source:IsA("BasePart")) then continue end
                    local id = source:GetAttribute("ItemID")
                    local entry = id and itemCatalog[id]
                    if not entry or type(entry.ItemName) ~= "string" then continue end
                    local kind = entry.ItemType
                    local grip = character and source:IsA("Tool") and equippedGrip(character, source)
                    local handle = grip and grip.Part1 or partOf(source)
                    if handle and (kind == "Knife" or kind == "Gun")
                        and captureWeaponEffects(source, handle, otherPlayer:GetAttribute("EquippedEffect")) then newEffects += 1 end
                    if kind ~= "Knife" and kind ~= "Gun" then continue end
                    local family = entry.EvoBaseID
                    local index = tonumber(source:GetAttribute("EvoIndex"))
                        or EvoRarityIndex[source:GetAttribute("Rarity")] or entry.EvoIndex
                    local phase = evoPhaseName(family, index)
                    local rarity = phase and EvoPhaseRarity[index] or entry.Rarity
                    local name = phase or (entry.ItemName .. " [" .. tostring(id) .. "]")
                    if grip and handle then
                        seen[name .. "::Hand"] = true
                        if captureWeapon(source, handle, kind, name, "Hand", grip.C1) then
                            newCount += 1
                            capturedPlayerWeapons[name .. "::Hand"] = true
                            saveCapturedWeapon(name, rarity, "Hand")
                        end
                    end
                end
            end
        end
        local total, visible = 0, 0
        for name in pairs(capturedPlayerWeapons) do
            total += 1
            if seen[name] then visible += 1 end
        end
        if newEffects > 0 then self:FlushEffectArchive() end
        return visible, newCount, total, newEffects
    end

