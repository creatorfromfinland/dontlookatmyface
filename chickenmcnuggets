    end

    local spireH = 4.2 * scale
    local spireY = topPeakY + spireH * 0.28
    for s = 1, 4 do
        local a = (s - 1) * (math.pi * 0.5)
        local dir = Vector3.new(math.cos(a), 0, math.sin(a))
        local pos = Vector3.new(worldX, spireY, worldZ) + dir * (0.65 * scale)
        makePart("WedgePart", {
            Name = "SpruceTop",
            Size = Vector3.new(1.25 * scale, spireH, 1.55 * scale),
