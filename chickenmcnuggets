						modifierInputs.Green.Text = g
						modifierInputs.Blue.Text = b

						hue, saturation, brightness = Color3.fromRGB(r, g, b):ToHSV()

						UpdateSlideFromValue(brightness)
						UpdateRingFromHSV(hue, saturation)
						update()
					end

