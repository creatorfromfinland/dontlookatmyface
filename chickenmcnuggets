    local function hideNativeShotObject(desc, character, muzzleWorldPos)
        if not desc or not desc.Parent or desc:IsDescendantOf(pathFolder) then return nil, false end
        local charPos = character and character:GetPivot().Position
        if desc:IsA("Beam") then
            local a0, a1 = desc.Attachment0, desc.Attachment1
            if a0 and a1 and a0.Parent and a1.Parent then
                local startPos = a0.WorldPosition
                local endPos = a1.WorldPosition
                if (endPos - startPos).Magnitude > 1 then
                    local d0 = (startPos - muzzleWorldPos).Magnitude
                    local d1 = (endPos - muzzleWorldPos).Magnitude
                    local dc = charPos and math.min((startPos - charPos).Magnitude, (endPos - charPos).Magnitude) or 999
                    if d0 < 25 or d1 < 25 or dc < 16 then
                        desc.Enabled = false
                        desc.Transparency = NumberSequence.new(1)
                        return (d0 <= d1) and endPos or startPos, true
                    end
                end
            end
        elseif desc:IsA("Trail") then
            local a0 = desc.Attachment0
            local pos = a0 and a0.Parent and a0.WorldPosition
            if pos and ((pos - muzzleWorldPos).Magnitude < 20 or (charPos and (pos - charPos).Magnitude < 16)) then
                desc.Enabled = false
                desc.Transparency = NumberSequence.new(1)
                return nil, true
            end
        elseif desc:IsA("BasePart") and not desc.CanCollide and not isCharacterObject(desc) then
            local n = desc.Name:lower()
            local looksLikeShot = n:find("beam", 1, true) or n:find("bullet", 1, true) or n:find("bolt", 1, true)
                or n:find("ray", 1, true) or n:find("laser", 1, true) or n:find("arrow", 1, true)
                or n:find("shot", 1, true) or n:find("ice", 1, true) or n:find("tracer", 1, true) or n:find("shard", 1, true)
            local dMuzzle = (desc.Position - muzzleWorldPos).Magnitude
            local dChar = charPos and (desc.Position - charPos).Magnitude or 999
            local maxAxis = math.max(desc.Size.X, desc.Size.Y, desc.Size.Z)
            local nearLine = maxAxis > 4 and (dMuzzle < maxAxis * 0.6 + 10)
            if (looksLikeShot and (dMuzzle < 40 or dChar < 30 or nearLine)) or (desc.Parent == workspace and dMuzzle < 16 and desc.Size.Magnitude < 20) then
                desc.LocalTransparencyModifier = 1
                desc.Transparency = 1
                for _, child in ipairs(desc:GetDescendants()) do
                    if child:IsA("Beam") or child:IsA("Trail") or child:IsA("ParticleEmitter") or child:IsA("PointLight") then
                        child.Enabled = false
                    elseif child:IsA("BasePart") then
                        child.LocalTransparencyModifier = 1
                        child.Transparency = 1
                    end
                end
                if maxAxis > 4 then
                    local half = desc.CFrame.LookVector * (maxAxis * 0.5)
                    local p1, p2 = desc.Position + half, desc.Position - half
                    return ((p1 - muzzleWorldPos).Magnitude >= (p2 - muzzleWorldPos).Magnitude) and p1 or p2, true
                end
                return nil, true
            end
        end
        return nil, false
    end

    local function showCustomGunShot(origin, character, tool, preset, forcedTargetPos)
        task.defer(function()
            local targetPos = forcedTargetPos
            if not targetPos then
                for _, child in ipairs(workspace:GetChildren()) do
                    local caught = hideNativeShotObject(child, character, origin)
                    if caught then targetPos = caught end
                end
            end

            if not targetPos then
                local mouseHit = player:GetMouse().Hit.Position
                local dir = (mouseHit - origin)
                if dir.Magnitude < 0.1 then return end
                local unitDir = dir.Unit
                local ignoreList = {character, pathFolder, workspace.CurrentCamera}
                if tool then table.insert(ignoreList, tool) end

                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.IgnoreWater = true

                local currentOrigin = origin
                local remainingDist = 600

                while remainingDist > 0 do
                    params.FilterDescendantsInstances = ignoreList
                    local hit = workspace:Raycast(currentOrigin, unitDir * remainingDist, params)
                    if not hit then
                        targetPos = origin + unitDir * 600
                        break
                    end
                    local hitPart = hit.Instance
                    local isCharacterPart = hitPart.Parent and (hitPart.Parent:FindFirstChildOfClass("Humanoid") or hitPart.Parent.Parent:FindFirstChildOfClass("Humanoid"))
                    local isAccessory = hitPart:FindFirstAncestorOfClass("Accessory") or hitPart:FindFirstAncestorOfClass("Hat")

                    if not isAccessory and (hitPart.CanCollide or isCharacterPart) and hitPart.Transparency < 0.95 then
                        targetPos = hit.Position
                        break
                    else
                        table.insert(ignoreList, hitPart)
                        remainingDist = remainingDist - (hit.Position - currentOrigin).Magnitude
                        currentOrigin = hit.Position + unitDir * 0.05
                    end
                end
            end

            if not targetPos then return end

            local anchor = Instance.new("Part")
            anchor.Name = "LarpChangerGunLaser"
            anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = true, false, false, false
            anchor.Transparency = 1
            anchor.Size = Vector3.new(0.1, 0.1, 0.1)
            anchor.CFrame = CFrame.new(origin)
            anchor.Parent = pathFolder

            local from = Instance.new("Attachment", anchor)
            local to = Instance.new("Attachment", anchor)
            to.WorldPosition = targetPos

            local lateConn
            lateConn = workspace.DescendantAdded:Connect(function(desc)
                task.defer(function()
                    if not anchor.Parent or not desc.Parent then return end
                    local caught = hideNativeShotObject(desc, character, origin)
                    if caught then to.WorldPosition = caught end
                end)
            end)
            task.delay(0.35, function()
                if lateConn then lateConn:Disconnect(); lateConn = nil end
            end)

            local outerBeam = Instance.new("Beam")
            outerBeam.Attachment0, outerBeam.Attachment1 = from, to
            outerBeam.FaceCamera = true
            outerBeam.LightEmission = 1
            outerBeam.LightInfluence = 0
            outerBeam.Brightness = preset.OuterBrightness
            outerBeam.Width0, outerBeam.Width1 = preset.OuterWidth[1], preset.OuterWidth[2]
            outerBeam.Color = preset.OuterColor
            outerBeam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.25),
                NumberSequenceKeypoint.new(0.85, 0.4),
                NumberSequenceKeypoint.new(1, 1)
            })
            outerBeam.Parent = anchor

            local coreBeam = Instance.new("Beam")
            coreBeam.Attachment0, coreBeam.Attachment1 = from, to
            coreBeam.FaceCamera = true
            coreBeam.LightEmission = 1
            coreBeam.LightInfluence = 0
            coreBeam.Brightness = preset.CoreBrightness
            coreBeam.Width0, coreBeam.Width1 = preset.CoreWidth[1], preset.CoreWidth[2]
            coreBeam.Color = preset.CoreColor
            coreBeam.Transparency = NumberSequence.new(0)
            coreBeam.Parent = anchor

            local flash = Instance.new("ParticleEmitter")
            flash.Texture = "rbxassetid://1539332776"
            flash.Color = preset.FlashColor
            flash.LightEmission = 1
            flash.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0)})
            flash.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
            flash.Lifetime = NumberRange.new(0.08, 0.14)
            flash.Speed = NumberRange.new(0, 0)
            flash.Rate = 0
            flash.Parent = from
            flash:Emit(4)

            if preset.ImpactSparks then
                local muzzleBurst = Instance.new("ParticleEmitter")
                muzzleBurst.Texture = "rbxassetid://2346141109"
                muzzleBurst.Color = preset.SparkColor or preset.FlashColor
                muzzleBurst.LightEmission = 1
                muzzleBurst.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.24), NumberSequenceKeypoint.new(1, 0)})
                muzzleBurst.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
                muzzleBurst.Lifetime = NumberRange.new(0.16, 0.28)
                muzzleBurst.Speed = NumberRange.new(3, 8)
                muzzleBurst.SpreadAngle = Vector2.new(35, 35)
                muzzleBurst.Drag = 4
                muzzleBurst.Rate = 0
                muzzleBurst.Parent = from
                muzzleBurst:Emit(8)

                local impact = muzzleBurst:Clone()
                impact.SpreadAngle = Vector2.new(180, 180)
                impact.Speed = NumberRange.new(4, 10)
                impact.Parent = to
                impact:Emit(12)
            end

            local tweenInfo = TweenInfo.new(preset.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            game:GetService("TweenService"):Create(outerBeam, tweenInfo, {Width0 = 0, Width1 = 0}):Play()
            game:GetService("TweenService"):Create(coreBeam, tweenInfo, {Width0 = 0, Width1 = 0}):Play()
            Debris:AddItem(anchor, preset.Duration + 0.15)
        end)
    end

    local function addGunSupport(tool, handle, record, name)
        local mode = State.SkinGunGrip
        local lowerName = name:lower()
        local gingerscope = lowerName:find("gingerscope", 1, true) ~= nil
        local redSnowcannon = lowerName:find("snowcannonred", 1, true) ~= nil or lowerName:find("red snowcannon", 1, true) ~= nil
        local shotPreset = gingerscope and CustomGunShots.Gingerscope or redSnowcannon and CustomGunShots.RedSnowcannon or nil
        local supportEnabled = mode == "Two Hands" or (mode == "Auto" and gingerscope)
        if not supportEnabled and not shotPreset then return end

        local character = tool.Parent
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        local longest, length = nil, 0
        for _, part in ipairs(record.Skin:GetChildren()) do
            if not part:IsA("BasePart") then continue end
            local size = part.Size
            local span = math.max(size.X, size.Y, size.Z)
            if span > length then longest, length = part, span end
        end
        if not longest then return end

        local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
        if not hand then return end

        local forwardAxis = -longest.CFrame.LookVector
        if (longest.Position - hand.Position):Dot(forwardAxis) < 0 then
            forwardAxis = -forwardAxis
        end

        if shotPreset then
            local muzzleOffset = Vector3.new(0, longest.Size.Y * shotPreset.MuzzleYRatio, longest.Size.Z * shotPreset.MuzzleZRatio)
            record.ShotConnections = record.ShotConnections or {}
            record.SoundBackups = record.SoundBackups or {}
            local lastShotTime = 0
            local soundData = shotPreset.SoundKey and findGunSoundData(shotPreset.SoundKey) or nil

            local function muzzlePos()
                return longest.CFrame:PointToWorldSpace(muzzleOffset)
            end

            local function triggerShot(forcedTarget)
                local t = os.clock()
                if t - lastShotTime < 0.22 then return end
                lastShotTime = t
                if tool.Parent == character and longest.Parent then
                    showCustomGunShot(muzzlePos(), character, tool, shotPreset, forcedTarget)
                end
            end

            local function applySoundOverride(sound)
                if not soundData then return end
                if not record.SoundBackups[sound] then
                    record.SoundBackups[sound] = {
                        SoundId = sound.SoundId,
                        PlaybackSpeed = sound.PlaybackSpeed,
                        Volume = sound.Volume,
                    }
                end
                if sound.SoundId ~= soundData.SoundId then
                    sound.SoundId = soundData.SoundId
                    sound.PlaybackSpeed = soundData.PlaybackSpeed or 1
                    sound.Volume = soundData.Volume or 1
                end
            end

            local function hookSound(sound)
                if not isShotSound(sound) then return end
                applySoundOverride(sound)
                table.insert(record.ShotConnections, sound.Played:Connect(function()
                    applySoundOverride(sound)
                    triggerShot()
                end))
                table.insert(record.ShotConnections, sound:GetPropertyChangedSignal("Playing"):Connect(function()
                    if sound.Playing then
                        applySoundOverride(sound)
                        triggerShot()
                    end
                end))
            end

            for _, desc in ipairs(tool:GetDescendants()) do
                if desc:IsA("Sound") then hookSound(desc) end
            end
            table.insert(record.ShotConnections, tool.DescendantAdded:Connect(function(desc)
                if desc:IsA("Sound") then hookSound(desc) end
            end))
            table.insert(record.ShotConnections, workspace.DescendantAdded:Connect(function(desc)
                if tool.Parent ~= character or not longest.Parent then return end
                if not (desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("BasePart")) then return end
                task.defer(function()
                    if tool.Parent ~= character or not longest.Parent or not desc.Parent then return end
                    local target, matched = hideNativeShotObject(desc, character, muzzlePos())
                    if matched then triggerShot(target) end
                end)
            end))
        end

        if not supportEnabled then return end

        local support = Instance.new("Attachment")
        support.Name = "LarpChangerLeftGrip"
        support.CFrame = longest.CFrame:ToObjectSpace(
            longest.CFrame * CFrame.new(-0.08, -0.22, -length * 0.16) * CFrame.Angles(0, math.rad(90), 0)
        )
        support.Parent = longest
        record.SupportTarget = support

        local upperArm = character:FindFirstChild("LeftUpperArm")
        local leftHand = character:FindFirstChild("LeftHand")
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")

        if upperArm and leftHand then
            local rightUpperArm = character:FindFirstChild("RightUpperArm")
            if gingerscope and torso and rightUpperArm and hand.Name == "RightHand" then
                local target = Instance.new("Attachment")
                target.Name = "LarpChangerRightGrip"
                target.CFrame = CFrame.new(torso.Size.X * 0.32, -0.05, -0.95) * CFrame.Angles(math.rad(90), 0, 0)
                target.Parent = torso
                record.AimTarget = target

                local aim = Instance.new("IKControl")
                aim.Name = "LarpChangerRightArm"
                aim.Type = Enum.IKControlType.Transform
                aim.ChainRoot = rightUpperArm
                aim.EndEffector = hand
                aim.Target = target
                aim.Priority = 10
                aim.SmoothTime = 0.04
                aim.Parent = humanoid
                record.AimIK = aim
            end

            local ik = Instance.new("IKControl")
            ik.Name = "LarpChangerLeftArm"
            ik.Type = Enum.IKControlType.Position
            ik.ChainRoot = upperArm
            ik.EndEffector = leftHand
            ik.Target = support
            ik.Priority = 11
            if torso then
                local pole = Instance.new("Attachment")
                pole.Name = "LarpChangerLeftElbow"
                pole.Position = Vector3.new(-torso.Size.X * 0.85, -torso.Size.Y * 0.5, -0.2)
                pole.Parent = torso
                ik.Pole = pole
                record.SupportPole = pole
            end
            ik.SmoothTime = 0.04
            ik.Parent = humanoid
            record.SupportIK = ik
        else
            local r6Torso = character:FindFirstChild("Torso")
            local shoulder = r6Torso and r6Torso:FindFirstChild("Left Shoulder")
            if shoulder and shoulder:IsA("Motor6D") and shoulder.Part1 then
                record.SupportShoulder = shoulder
                record.SupportShoulderC0 = shoulder.C0
            end
        end
    end

    local function updateGunSupport(record)
        local shoulder = record.SupportShoulder
        if not shoulder or not shoulder.Part0 or not shoulder.Part1 then return end
        local pivot = (shoulder.Part0.CFrame * record.SupportShoulderC0).Position
        local delta = record.SupportTarget.WorldPosition - pivot
        if delta.Magnitude < 0.01 then return end
        local up = -delta.Unit
        local right = shoulder.Part0.CFrame.LookVector:Cross(up)
        if right.Magnitude < 0.01 then right = shoulder.Part0.CFrame.RightVector:Cross(up) end
        local arm = CFrame.fromMatrix(pivot, right.Unit, up)
        local joint = arm * shoulder.C1.Rotation
        shoulder.C0 = shoulder.Part0.CFrame:ToObjectSpace(joint) * shoulder.Transform:Inverse()
    end

    local function applyWeaponLook(tool, handle, kind, grip)
        local style = (kind ~= "Gun" or State.SkinGunEffect) and State.WeaponEffect or "Original"
        local name = kind == "Gun" and State.SkinGunHand or splitKnifeSelection(State.KnifeSkin)
        local definition = grip and State.SkinChanger and WeaponPoseModels[name] and WeaponPoseModels[name].Hand
        local appearanceOnly = not definition and needsWeaponAppearance(kind) and handle.Archivable
        if not definition and not appearanceOnly and style == "Original" then return end
       local record = {Active = true, Handle = handle, Grip = grip, Hidden = {}, HideConns = {}, Effects = {}}
        skins[tool] = record
        if definition then
            record.Skin = mountSkin(tool, handle, name, grip, nil, false, nil, definition)
            if kind == "Gun" then addGunSupport(tool, handle, record, name) end
        end
        if appearanceOnly then
            local pieces = {}
            for _, source in ipairs(tool:GetDescendants()) do
                if source:IsA("BasePart") and source.Archivable and source.Transparency < 1 then
                    table.insert(pieces, {
                        Template = cloneWeaponAppearance(source),
                        Relative = handle.CFrame:ToObjectSpace(source.CFrame),
                    })
                end
            end
            if #pieces > 0 then
                record.Skin = mountSkin(tool, handle, nil, nil, nil, false, nil, {Kind = kind, Pieces = pieces})
                for _, piece in ipairs(pieces) do piece.Template:Destroy() end
            end
        end
        if style ~= "Original" then mountWeaponEffect(handle, kind, record, style) end
    end

