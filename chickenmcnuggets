            if not (part:IsA("Part") or part:IsA("WedgePart") or part:IsA("CornerWedgePart") or part:IsA("MeshPart")) then return end
            local data = {
                Class = part.ClassName, Relative = {piece.Relative:GetComponents()},
                Properties = copyProperties(part, partProperties), Appearance = {},
            }
            if part:IsA("MeshPart") then
                data.Mesh = part.MeshId
                data.Texture = part.TextureID
            elseif part:IsA("Part") then
                data.Shape = part.Shape.Name
            end
            for _, child in ipairs(part:GetChildren()) do
                local properties = appearanceProperties[child.ClassName]
                if properties then table.insert(data.Appearance, {Class = child.ClassName, Properties = copyProperties(child, properties)}) end
            end
            table.insert(saved.Pieces, data)
        end
        archive[key] = saved
        archiveDirty = true
        if archivePending then return end
