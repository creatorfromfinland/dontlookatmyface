local function updateWeaponOptions(model)
    local options = model.Options
    table.sort(options, function(a, b)
        if a == "Original" then return b ~= "Original" end
        if b == "Original" then return false end
        return a < b
    end)
    local control = model.Control
    local pending = control.PendingSelection
    local available = pending and table.find(options, pending)
    local selected = control.Value or "Original"
    control:ClearOptions()
    control:InsertOptions(options)
    if available then
        control:UpdateSelection(pending)
    elseif selected ~= "Original" then
        control:UpdateSelection(selected)
        control.PendingSelection = pending
    else
        control.PendingSelection = pending
    end
end

Runtime.OnWeaponParsed = function(kind, name, pose)
