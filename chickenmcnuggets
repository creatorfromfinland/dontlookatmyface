    else
        model = knifeModels[knifePoseSuffix[pose] and pose or "Original"]
    end
    if not model then return end
    local options = model.Options
    if table.find(options, name) then return end
    table.insert(options, name)
    if model.RefreshPending then return end
    model.RefreshPending = true
    task.delay(0.18, function()
        model.RefreshPending = false
        if Runtime.Alive then updateWeaponOptions(model) end
    end)
end
