    local function packProperty(value)
        local kind = typeof(value)
        if kind == "Vector3" then return {"Vector3", value.X, value.Y, value.Z} end
        if kind == "Vector2" then return {"Vector2", value.X, value.Y} end
        if kind == "Color3" then return {"Color3", value.R, value.G, value.B} end
        if kind == "NumberRange" then return {"NumberRange", value.Min, value.Max} end
        if kind == "NumberSequence" or kind == "ColorSequence" then
            local result = {kind}
            for _, point in ipairs(value.Keypoints) do
                local item = {point.Time}
                if kind == "NumberSequence" then
                    item[2], item[3] = point.Value, point.Envelope
                else
                    item[2], item[3], item[4] = point.Value.R, point.Value.G, point.Value.B
                end
                table.insert(result, item)
            end
            return result
        end
        if kind == "EnumItem" then return {"Enum", tostring(value.EnumType):match("^Enum%.(.+)$"), value.Name} end
        if kind == "string" or kind == "number" or kind == "boolean" then return value end
        return nil
    end
    local function unpackProperty(value)
        if type(value) ~= "table" then return value end
        if value[1] == "Vector3" then return Vector3.new(value[2], value[3], value[4]) end
        if value[1] == "Vector2" then return Vector2.new(value[2], value[3]) end
        if value[1] == "Color3" then return Color3.new(value[2], value[3], value[4]) end
        if value[1] == "NumberRange" then return NumberRange.new(value[2], value[3]) end
        if value[1] == "NumberSequence" then
            local points = {}
            for i = 2, #value do
                local point = value[i]
                table.insert(points, NumberSequenceKeypoint.new(point[1], point[2], point[3]))
            end
            return NumberSequence.new(points)
        end
        if value[1] == "ColorSequence" then
            local points = {}
            for i = 2, #value do
                local point = value[i]
                table.insert(points, ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4])))
            end
            return ColorSequence.new(points)
        end
        if value[1] == "Enum" then return Enum[value[2]][value[3]] end
        return nil
    end
    local function copyProperties(instance, names, saved)
        local values = {}
        for _, key in ipairs(names) do
            if saved then
