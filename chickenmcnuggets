        Color = Color3.fromRGB(68, 44, 28),
        CFrame = CFrame.new(worldX, baseY + lowerTrunkH * 0.45, worldZ) * CFrame.Angles(0, 0, math.rad(90)),
    })

    local upperTrunkH = 17.5 * scale
    makePart("Part", {
        Name = "TrunkUpper",
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(upperTrunkH, 1.35 * scale, 1.35 * scale),
        Material = Enum.Material.Wood,
        Color = Color3.fromRGB(62, 40, 26),
        CFrame = CFrame.new(worldX, baseY + lowerTrunkH * 0.8 + upperTrunkH * 0.5, worldZ) * CFrame.Angles(0, 0, math.rad(90)),
    })

    local tiers = 7
