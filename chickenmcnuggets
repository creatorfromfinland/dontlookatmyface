        local tierBaseY = baseY + (3.6 + (t - 1) * 3.15) * scale
        local tierCenterY = tierBaseY + tierHeight * 0.46
        topPeakY = tierBaseY + tierHeight

        local coreR = radius * 0.78
        local corePart = makePart("Part", {
            Name = "FoliageCore",
            Shape = Enum.PartType.Cylinder,
            Size = Vector3.new(tierHeight * 0.72, coreR, coreR),
            Material = Enum.Material.LeafyGrass,
            Color = Color3.fromRGB(
                math.clamp(16 + t * 2 + baseHueShift, 10, 40),
                math.clamp(50 + t * 4 + baseHueShift, 35, 95),
                math.clamp(30 + t * 2 + baseHueShift, 20, 60)
            ),
            CFrame = CFrame.new(worldX, tierCenterY - 0.25 * scale, worldZ) * CFrame.Angles(0, 0, math.rad(90)),
        })
        if t == 3 then
            lightAnchor = corePart
        end

        local boughs = (t <= 4) and 8 or 6
        local ringOffset = (t * 0.48) + math.random() * 0.25
        local greenMain = Color3.fromRGB(
            math.clamp(18 + t * 2 + baseHueShift, 12, 46),
            math.clamp(62 + t * 4 + baseHueShift, 44, 108),
            math.clamp(36 + t * 2 + baseHueShift, 24, 68)
        )
        local greenDark = Color3.fromRGB(
            math.clamp(13 + t * 2 + baseHueShift, 8, 36),
            math.clamp(46 + t * 3 + baseHueShift, 32, 84),
            math.clamp(28 + t * 2 + baseHueShift, 18, 54)
