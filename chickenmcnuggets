local function isRoofOverRoom(part, worldPos, wy)
    local bottomY = part.Position.Y - (wy * 0.5)
    local origin = Vector3.new(worldPos.X, bottomY - 0.35, worldPos.Z)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { rootFolder, part }

    local res = Workspace:Raycast(origin, Vector3.new(0, -40, 0), params)
    if res and res.Distance >= 3.5 then
        return true
    end
    return false
end

local function matchSnowTone(groundColor, delta)
    local r = math.clamp(math.floor(groundColor.R * 255) + delta, 228, 252)
    local g = math.clamp(math.floor(groundColor.G * 255) + delta, 234, 254)
    local b = math.clamp(math.floor(groundColor.B * 255) + delta, 245, 255)
    return Color3.fromRGB(r, g, b)
end

-- 4A. Снежный намёт у стены (многослойный плавный склон WedgePart в стиле зимнего MM2)
local function spawnWallSnowBank(parentFolder, wallBasePos, normal, groundColor, length, height, depth)
    local bankModel = Instance.new("Model")
    bankModel.Name = "WallSnowBank"
    bankModel.Parent = parentFolder

    local tangent = Vector3.new(-normal.Z, 0, normal.X)

    local function addWedgeLayer(len, hgt, dep, shiftSide, toneDelta)
        local w = Instance.new("WedgePart")
        w.Name = "SnowSlope"
        w.Size = Vector3.new(len, hgt, dep)
        w.Material = Enum.Material.Snow
        w.Color = matchSnowTone(groundColor, toneDelta)
        w.Anchored = true
        w.CanCollide = false
        w.CanQuery = false
        w.CanTouch = false
        w.CastShadow = false

        -- Задняя вертикальная грань (+Z) вплотную к стене, пологий склон (-Z) плавно сходит на снег
        local center = wallBasePos
            + tangent * shiftSide
            + normal * (dep * 0.5 - 0.08)
            + Vector3.new(0, hgt * 0.5 - 0.05, 0)

        w.CFrame = CFrame.lookAt(center, center + normal)
        w.Parent = bankModel
    end

    local asymShift = (math.random() * 2 - 1) * (length * 0.08)

    -- 1. Нижний широкий пологий шлейф (плавно вливается в землю)
    addWedgeLayer(length, height * 0.38, depth * 1.18, 0, 0)
    -- 2. Основной средний вал сугроба
    addWedgeLayer(length * 0.78, height * 0.72, depth * 0.96, asymShift * 0.6, 2)
    -- 3. Верхний гребень надува у самой стены
    addWedgeLayer(length * 0.48, height, depth * 0.72, asymShift, 4)
end

-- Поиск сплошных уличных стен и расстановка аккуратных намётов вдоль них
local function populateWallSnowBanks(groundCandidates, decorFolder, placedWallPositions)
    local wallCount = 0
    local dirs = {
        Vector3.new(1, 0, 0),
        Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1),
        Vector3.new(0, 0, -1),
    }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreBase = { rootFolder }
    if LocalPlayer.Character then table.insert(ignoreBase, LocalPlayer.Character) end
    rayParams.FilterDescendantsInstances = ignoreBase

    local candidatesList = {}

    for _, cand in ipairs(groundCandidates) do
        local part = cand.Part
        local topY = cand.TopY
        local step = 14
        local halfX = math.max(0, part.Size.X * 0.5 - 4)
        local halfZ = math.max(0, part.Size.Z * 0.5 - 4)

        for lx = -halfX, halfX, step do
            for lz = -halfZ, halfZ, step do
                local pt = (part.CFrame * CFrame.new(lx, part.Size.Y * 0.5, lz)).Position
                for _, dir in ipairs(dirs) do
                    local hit = Workspace:Raycast(pt + Vector3.new(0, 1.8, 0), dir * 13, rayParams)
                    if hit and hit.Instance and hit.Instance ~= part then
                        local wObj = hit.Instance
                        if wObj:IsA("BasePart")
                            and wObj.CanCollide
                            and wObj.Transparency < 0.15
                            and not isCharacterPart(wObj)
                            and not hasNameFromList(wObj, BAD_WALL_BANK_TARGETS, 4)
                            and math.abs(hit.Normal.Y) < 0.18
                        then
                            local _, wwy, _ = getWorldSize(wObj)
                            if wwy >= 5.5 then
                                local normal = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
                                if normal.Magnitude > 0.1 then
                                    table.insert(candidatesList, {
                                        WallBase = Vector3.new(hit.Position.X, topY, hit.Position.Z),
                                        Normal = normal.Unit,
                                        GroundPart = part,
                                        GroundColor = part.Color,
                                        TopY = topY,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Перемешиваем кандидатов, чтобы намёты распределялись по всей карте, а не в одном углу
    for i = #candidatesList, 2, -1 do
        local j = math.random(1, i)
        candidatesList[i], candidatesList[j] = candidatesList[j], candidatesList[i]
    end

    for _, c in ipairs(candidatesList) do
        if wallCount >= CONFIG.MaxWallDriftsPerMap then break end

        local wallBase = c.WallBase
        local normal = c.Normal
        local tangent = Vector3.new(-normal.Z, 0, normal.X)
        local topY = c.TopY

        local tooClose = false
        for _, p in ipairs(placedWallPositions) do
            if (wallBase - p).Magnitude < CONFIG.MinWallDriftSpacing then
                tooClose = true
                break
            end
        end

        if not tooClose then
            local length = math.random(105, 165) / 10  -- 10.5 - 16.5 стадов вдоль стены
            local height = math.random(15, 24) / 10    -- 1.5 - 2.4 стада в высоту
            local depth = math.random(46, 68) / 10     -- 4.6 - 6.8 стадов пологий выход на землю

            -- 1. Проверяем, что стена сплошная слева и справа (не перекрываем двери и проёмы!)
            local solidWall = true
            for _, sideFactor in ipairs({ -0.45, 0, 0.45 }) do
                local probeOrigin = wallBase + tangent * (length * sideFactor) + normal * 2.5 + Vector3.new(0, 1.8, 0)
                local wHit = Workspace:Raycast(probeOrigin, -normal * 4.2, rayParams)
                if not wHit or wHit.Distance < 1.6 or wHit.Distance > 3.2
                    or wHit.Instance.Transparency >= 0.15
                    or hasNameFromList(wHit.Instance, BAD_WALL_BANK_TARGETS, 4) then
                    solidWall = false
                    break
                end
            end

            -- 2. Проверяем ровный уличный снег и открытое небо перед стеной
            if solidWall then
                local clearGround = true
                local checkPoints = {
                    wallBase + normal * 1.6,
                    wallBase + normal * (depth * 0.9),
                    wallBase + tangent * (length * 0.42) + normal * (depth * 0.65),
                    wallBase - tangent * (length * 0.42) + normal * (depth * 0.65),
                }
                for _, cp in ipairs(checkPoints) do
                    local gHit = Workspace:Raycast(cp + Vector3.new(0, 0.8, 0), Vector3.new(0, -1.6, 0), rayParams)
                    if not gHit or math.abs(gHit.Position.Y - topY) > 0.25
                        or gHit.Instance.Material == Enum.Material.Ice
                        or hasNameFromList(gHit.Instance, BAD_DRIFT_NAMES, 4) then
                        clearGround = false
                        break
                    end
                    if not isPointOpenToSky(cp, 150) then
                        clearGround = false
                        break
                    end
                end

                -- 3. Проверяем, чтобы перед стеной не стояли ящики, танк или заборы
                if clearGround then
                    local ok, overlaps = pcall(function()
                        local op = OverlapParams.new()
                        op.FilterType = Enum.RaycastFilterType.Exclude
                        local ign = { rootFolder, c.GroundPart }
                        if LocalPlayer.Character then table.insert(ign, LocalPlayer.Character) end
                        op.FilterDescendantsInstances = ign

                        local boxCenterPos = wallBase + normal * (depth * 0.55 + 0.5) + Vector3.new(0, height * 0.5 + 0.4, 0)
                        local boxCF = CFrame.lookAt(boxCenterPos, boxCenterPos + normal)
                        local boxSize = Vector3.new(length + 0.8, height + 0.6, depth - 0.3)
                        return Workspace:GetPartBoundsInBox(boxCF, boxSize, op)
                    end)

                    local blocked = false
                    if ok and overlaps then
                        for _, obj in ipairs(overlaps) do
                            if obj:IsA("BasePart") and obj.Transparency < 0.85 and not isCharacterPart(obj) then
                                local n = obj.Name:lower()
                                if not (n:find("coin") or n:find("spawn")) then
                                    local _, owy, _ = getWorldSize(obj)
                                    if (obj.Position.Y + owy * 0.5) > topY + 0.30 then
                                        blocked = true
                                        break
                                    end
                                end
                            end
                        end
                    end

                    if not blocked then
                        spawnWallSnowBank(decorFolder, wallBase, normal, c.GroundColor, length, height, depth)
                        table.insert(placedWallPositions, wallBase)
                        wallCount += 1
                    end
                end
            end
        end
    end

    return wallCount
end

-- 4B. Широкая пологая снежная волна (перемёт) — центр СТРОГО ниже пола, никакого "облачка" и подгиба
local function isSafeOpenWaveSpot(part, worldPos, topY, wy, halfLen, halfWid, yaw, visibleH)
    local dirX = math.cos(yaw)
    local dirZ = math.sin(yaw)
    local perpX = -dirZ
    local perpZ = dirX

    local sampleOffsets = {
        Vector3.new(0, 0, 0),
        Vector3.new(dirX * halfLen * 0.82, 0, dirZ * halfLen * 0.82),
        Vector3.new(-dirX * halfLen * 0.82, 0, -dirZ * halfLen * 0.82),
        Vector3.new(perpX * halfWid * 0.82, 0, perpZ * halfWid * 0.82),
        Vector3.new(-perpX * halfWid * 0.82, 0, -perpZ * halfWid * 0.82),
    }

    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Exclude
    local gIgnore = { rootFolder }
    if LocalPlayer.Character then table.insert(gIgnore, LocalPlayer.Character) end
    groundParams.FilterDescendantsInstances = gIgnore

    for _, off in ipairs(sampleOffsets) do
        local pt = worldPos + off
        -- Ни одна точка волны не должна находиться над комнатой/потолком этажа ниже
        if isRoofOverRoom(part, pt, wy) then
            return false
        end

        local hit = Workspace:Raycast(Vector3.new(pt.X, topY + 0.7, pt.Z), Vector3.new(0, -1.4, 0), groundParams)
        if not hit or math.abs(hit.Position.Y - topY) > 0.20 then
            return false
        end
        if hit.Instance.Material == Enum.Material.Ice or hasNameFromList(hit.Instance, BAD_DRIFT_NAMES, 5) then
            return false
        end
        if not isPointOpenToSky(Vector3.new(pt.X, topY, pt.Z), 150) then
            return false
        end
    end

    -- Проверка объёма над землёй (не наезжаем на танки, ящики, фонтан, заборы)
    local ok, overlaps = pcall(function()
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        local ign = { rootFolder, part }
        if LocalPlayer.Character then table.insert(ign, LocalPlayer.Character) end
        op.FilterDescendantsInstances = ign

        local boxCF = CFrame.new(worldPos.X, topY + visibleH * 0.5 + 0.35, worldPos.Z) * CFrame.Angles(0, yaw, 0)
        local boxSize = Vector3.new(halfLen * 1.9 + 2.0, visibleH + 1.0, halfWid * 1.9 + 2.0)
        return Workspace:GetPartBoundsInBox(boxCF, boxSize, op)
    end)

    if ok and overlaps then
        for _, obj in ipairs(overlaps) do
            if obj:IsA("BasePart") and obj.Transparency < 0.85 and not isCharacterPart(obj) then
                local n = obj.Name:lower()
                if not (n:find("coin") or n:find("spawn")) then
                    local _, owy, _ = getWorldSize(obj)
                    if (obj.Position.Y + owy * 0.5) > topY + 0.25 then
                        return false
                    end
                end
            end
        end
    end

    return true
end

local function spawnSmoothSnowWave(parentFolder, worldPos, topY, yaw, groundColor, len, wid, visibleH)
    local waveModel = Instance.new("Model")
    waveModel.Name = "SmoothSnowWave"
    waveModel.Parent = parentFolder

    local dirX = math.cos(yaw)
    local dirZ = math.sin(yaw)

    -- Центр эллипсоида находится ЗАВЕДОМО НИЖЕ уровня пола (утоплен на ~72%),
    -- поэтому из земли торчит только верхняя плавная пологая шапка без подгиба и тёмной кромки!
    local function addCap(offF, l, w, visH, toneDelta)
        local fullH = visH * 3.8
        local p = Instance.new("Part")
        p.Name = "SnowWaveCap"
        p.Size = Vector3.new(l, fullH, w)
        p.Material = Enum.Material.Snow
        p.Color = matchSnowTone(groundColor, toneDelta)
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false

        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Parent = p

        local centerY = topY + visH - (fullH * 0.5)
        p.CFrame = CFrame.new(worldPos.X + dirX * offF, centerY, worldPos.Z + dirZ * offF) * CFrame.Angles(0, yaw, 0)
        p.Parent = waveModel
    end

    -- Главная широкая пологая волна
    addCap(0, len, wid, visibleH, 1)
    -- Длинный пологий ветровой шлейф
    addCap(len * 0.24, len * 0.72, wid * 0.80, visibleH * 0.68, 0)
end

