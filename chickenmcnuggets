        for i = 1, boughs do
            local angle = ringOffset + (i - 1) * (2 * math.pi / boughs) + math.rad(math.random(-8, 8))
            local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
            local lenJitter = math.random(92, 108) / 100
            local bLen = radius * lenJitter
            local bWid = bLen * (0.64 - frac * 0.08)
            local droopRad = math.rad(-10 + frac * 5 + math.random(-2, 2))
            local rollRad = math.rad(math.random(-5, 5))

            local bPos = Vector3.new(worldX, tierCenterY, worldZ) + dir * (bLen * 0.47)
