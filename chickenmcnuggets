    local function isShotSound(sound)
        if not sound:IsA("Sound") or sound.SoundId == "" then return false end
        local n = sound.Name:lower()
        if n:find("equip", 1, true) or n:find("unequip", 1, true) or n:find("reload", 1, true)
            or n:find("click", 1, true) or n:find("empty", 1, true) or n:find("holster", 1, true) then
            return false
        end
        return true
    end

    local function saveGunSound(key, sound)
        if not canArchive or not sound or sound.SoundId == "" then return end
        local existing = gunSoundArchive[key]
        if existing and existing.SoundId == sound.SoundId then return end
        gunSoundArchive[key] = {
            SoundId = sound.SoundId,
            PlaybackSpeed = sound.PlaybackSpeed,
            Volume = sound.Volume,
        }
        pcall(function()
            writefile(gunSoundArchivePath, archiveHttp:JSONEncode(gunSoundArchive))
        end)
    end

    local function extractSoundFromTable(tbl, depth)
        if type(tbl) ~= "table" or (depth or 0) > 3 then return nil end
        for k, v in pairs(tbl) do
            local key = tostring(k):lower()
            if key:find("sound", 1, true) or key:find("audio", 1, true) or key:find("gunshot", 1, true) or key:find("shoot", 1, true) then
                if type(v) == "number" and v > 10000 then
                    return {SoundId = "rbxassetid://" .. tostring(v), PlaybackSpeed = 1, Volume = 1}
                elseif type(v) == "string" then
                    local num = v:match("(%d%d%d%d%d+)")
                    if num then return {SoundId = "rbxassetid://" .. num, PlaybackSpeed = 1, Volume = 1} end
                elseif type(v) == "table" then
                    local nested = extractSoundFromTable(v, (depth or 0) + 1)
                    if nested then return nested end
                end
            end
        end
        return nil
    end

    local cachedGunSounds = {}
    local function findGunSoundData(gunKey)
        local manual = CustomGunSounds[gunKey] or CustomGunSounds.Snowcannon
        if type(manual) == "string" and manual ~= "" then
            return {SoundId = manual, PlaybackSpeed = 1, Volume = 1}
        end
        if cachedGunSounds[gunKey] then return cachedGunSounds[gunKey] end
        if gunSoundArchive[gunKey] and gunSoundArchive[gunKey].SoundId ~= "" then
            cachedGunSounds[gunKey] = gunSoundArchive[gunKey]
            return cachedGunSounds[gunKey]
        end
        if gunKey == "SnowcannonRed" and gunSoundArchive.Snowcannon and gunSoundArchive.Snowcannon.SoundId ~= "" then
            cachedGunSounds[gunKey] = gunSoundArchive.Snowcannon
            return cachedGunSounds[gunKey]
        end
        for _, id in ipairs({gunKey, "Snowcannon"}) do
            local found = extractSoundFromTable(itemCatalog and itemCatalog[id], 0)
            if found then
                cachedGunSounds[gunKey] = found
                return found
            end
        end
        for _, container in ipairs({Storage, game:GetService("SoundService")}) do
            for _, desc in ipairs(container:GetDescendants()) do
                if desc:IsA("Sound") and desc.SoundId ~= "" then
                    local full = (desc.Name .. " " .. (desc.Parent and desc.Parent.Name or "")):lower()
                    if full:find("snowcannon", 1, true) then
                        saveGunSound(gunKey, desc)
                        cachedGunSounds[gunKey] = {SoundId = desc.SoundId, PlaybackSpeed = desc.PlaybackSpeed, Volume = desc.Volume}
                        return cachedGunSounds[gunKey]
                    end
                end
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            for _, container in ipairs({plr.Character, plr:FindFirstChildOfClass("Backpack")}) do
                if not container then continue end
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        local itemId = tostring(item:GetAttribute("ItemID") or ""):lower()
                        if itemId:find("snowcannon", 1, true) then
                            for _, s in ipairs(item:GetDescendants()) do
                                if isShotSound(s) then
                                    saveGunSound(gunKey, s)
                                    cachedGunSounds[gunKey] = {SoundId = s.SoundId, PlaybackSpeed = s.PlaybackSpeed, Volume = s.Volume}
                                    return cachedGunSounds[gunKey]
                                end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

