local processedModels = setmetatable({}, { __mode = "k" })

local function backupPart(obj)
    if not modifiedParts[obj] then
        modifiedParts[obj] = {
            Material = obj.Material,
            Color = obj.Color,
            Reflectance = obj.Reflectance,
        }
    end
end

local function snowifyModel(model)
    if not model or not model.Parent or processedModels[model] then return end
    if model == rootFolder or isCharacterPart(model) then return end
    if Players:GetPlayerFromCharacter(model) then return end

    processedModels[model] = true

    local bgTreeMap = isBackgroundTreeMap(model.Name)
    local semiOutdoor = isSemiOutdoorMapName(model.Name)
    local closedMap = (not semiOutdoor) and isClosedMapName(model.Name)

    if closedMap and model:IsA("Model") then
        local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
        if ok and cf and size then
            closedMapBoxes[model] = { CFrame = cf, Size = size }
        end
    end

    local decorFolder = Instance.new("Folder")
    decorFolder.Name = "Decor_" .. model.Name
    decorFolder.Parent = rootFolder

    local ancestryConn
    ancestryConn = model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            closedMapBoxes[model] = nil
            if decorFolder and decorFolder.Parent then
                decorFolder:Destroy()
            end
            if ancestryConn then ancestryConn:Disconnect() end
        end
    end)
    table.insert(connections, ancestryConn)

    local groundCandidates = {}
    local placedWallPositions = {}
    local placedWavePositions = {}
    local wallDriftCount = 0
    local openWaveCount = 0
    local bgTreeCount = 0
    local requiredSkyPoints = semiOutdoor and 1 or 2
    local mapWindYaw = math.rad(math.random(0, 360))

    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency < 0.85 and not isCharacterPart(obj) then
            local isProtectedProp = hasNameFromList(obj, PROTECTED_PROP_NAMES, 3)

            if not isProtectedProp then
                local wx, wy, wz = getWorldSize(obj)
                local isVertical = isWallOrVertical(obj, wx, wy, wz)
                local maxHoriz = math.max(wx, wz)
                local minHoriz = math.min(wx, wz)

                local isFlatGround = (not isVertical)
                    and (wy <= 3.2)
                    and (maxHoriz >= 1.2)
                    and (wy <= maxHoriz * 0.65)
                local isFlatWedge = (obj:IsA("WedgePart") or obj:IsA("CornerWedgePart"))
                    and (wy <= 2.4)
                    and (maxHoriz >= 2.0)

                if CONFIG.SnowifyMaps and (isWaterName(obj.Name) or obj.Material == Enum.Material.Water) then
                    if not closedMap or isPartOutdoorsWorld(obj, wx, wy, wz, 1) then
                        backupPart(obj)
                        obj.Material = Enum.Material.Ice
                        obj.Color = Color3.fromRGB(178, 222, 248)
                        obj.Reflectance = 0.18
                    end
                elseif CONFIG.SnowifyMaps then
                    local shouldSnow = false
                    local isFoliage = isFoliageName(obj.Name) or (isGreenish(obj.Color) and obj.Material == Enum.Material.Grass)
                    local isNaturalRock = NATURAL_ROCK_MATERIALS[obj.Material] == true
                    local isGroundMat = GROUND_SNOW_MATERIALS[obj.Material] == true

                    if ALWAYS_SNOW_MATERIALS[obj.Material] or isFoliage then
                        if (not closedMap) or isPartOutdoorsWorld(obj, wx, wy, wz, 1) then
                            shouldSnow = true
                        end
                    elseif not closedMap then
                        if isNaturalRock and isPartOutdoorsWorld(obj, wx, wy, wz, requiredSkyPoints) then
                            shouldSnow = true
                        elseif CONFIG.SnowifyAllOutdoorGround and (isFlatGround or isFlatWedge) then
                            local allowedMat = isGroundMat
                                or (isFlatWedge and obj.Material ~= Enum.Material.Glass and obj.Material ~= Enum.Material.Neon and obj.Material ~= Enum.Material.Wood and obj.Material ~= Enum.Material.WoodPlanks)
                                or (wy <= 1.2 and minHoriz >= 2.5 and (obj.Material == Enum.Material.Metal or obj.Material == Enum.Material.DiamondPlate or obj.Material == Enum.Material.CorrodedMetal))

                            if allowedMat and isPartOutdoorsWorld(obj, wx, wy, wz, requiredSkyPoints) then
                                shouldSnow = true
                            end
                        end
                    end

                    if shouldSnow then
                        backupPart(obj)
                        obj.Material = Enum.Material.Snow
                        if isFoliage and not ALWAYS_SNOW_MATERIALS[modifiedParts[obj].Material] then
                            obj.Color = Color3.fromRGB(224, 240, 252)
                        else
                            local s = math.random(238, 246)
                            obj.Color = Color3.fromRGB(s, math.min(255, s + 4), 255)
                        end

                        if CONFIG.HideGroundTextures then
                            for _, child in ipairs(obj:GetChildren()) do
                                if child:IsA("Texture") or child:IsA("Decal") then
                                    if child.Face == Enum.NormalId.Top or isFoliage or isNaturalRock or isFlatWedge or isFlatGround then
                                        if not modifiedTextures[child] then
                                            modifiedTextures[child] = child.Transparency
                                        end
                                        child.Transparency = 1
                                    end
                                end
                            end
                        end
                    end
                end

                if not closedMap
                    and obj:IsA("Part")
                    and obj.Shape == Enum.PartType.Block
                    and math.abs(obj.CFrame.UpVector.Y) > 0.88
                    and not isVertical
                    and obj.CanCollide
                    and obj.Material == Enum.Material.Snow
                    and wx >= 12
                    and wz >= 12
                    and not hasNameFromList(obj, BAD_DRIFT_NAMES, 5)
                then
                    table.insert(groundCandidates, {
                        Part = obj,
                        WX = wx,
                        WY = wy,
                        WZ = wz,
                        TopY = obj.Position.Y + (wy * 0.5),
                    })
                end
            end
        end
    end

    if closedMap then
        return
    end

    -- 1. СНЕЖНЫЕ НАМЁТЫ ВДОЛЬ СТЕН (как в зимнем MM2)
    if CONFIG.WallDriftsEnabled and #groundCandidates > 0 then
        wallDriftCount = populateWallSnowBanks(groundCandidates, decorFolder, placedWallPositions)
    end

    -- 2. ШИРОКИЕ ПЛАВНЫЕ СНЕЖНЫЕ ПЕРЕМЁТЫ НА ОТКРЫТОМ СНЕГУ
    if CONFIG.OpenWavesEnabled and #groundCandidates > 0 then
        for _, cand in ipairs(groundCandidates) do
            if openWaveCount >= CONFIG.MaxOpenWavesPerMap then break end

            local part = cand.Part
            if cand.WX >= 20 and cand.WZ >= 20 then
                local attempts = math.clamp(math.floor((cand.WX * cand.WZ) * 0.00022), 1, 3)
                local marginX = math.min(10, cand.WX * 0.28)
                local marginZ = math.min(10, cand.WZ * 0.28)

                for _ = 1, attempts do
                    if openWaveCount >= CONFIG.MaxOpenWavesPerMap then break end

                    local len = math.random(135, 185) / 10
                    local wid = math.random(85, 115) / 10
                    local visH = math.random(9, 14) / 10
                    local yaw = mapWindYaw + math.rad(math.random(-20, 20))

                    local rx = (math.random() * 2 - 1) * ((part.Size.X * 0.5) - marginX)
                    local rz = (math.random() * 2 - 1) * ((part.Size.Z * 0.5) - marginZ)
                    local spawnWorld = (part.CFrame * CFrame.new(rx, part.Size.Y * 0.5, rz)).Position

                    local tooClose = false
                    for _, wp in ipairs(placedWavePositions) do
                        if (spawnWorld - wp).Magnitude < CONFIG.MinOpenWaveSpacing then
                            tooClose = true
                            break
                        end
                    end
                    if not tooClose then
                        for _, wallPos in ipairs(placedWallPositions) do
                            if (spawnWorld - wallPos).Magnitude < 14 then
                                tooClose = true
                                break
                            end
                        end
                    end

                    if not tooClose and isSafeOpenWaveSpot(part, spawnWorld, cand.TopY, cand.WY, len * 0.5, wid * 0.5, yaw, visH) then
                        spawnSmoothSnowWave(decorFolder, spawnWorld, cand.TopY, yaw, part.Color, len, wid, visH)
                        table.insert(placedWavePositions, spawnWorld)
                        openWaveCount += 1
                    end
                end
            end
        end
    end

    -- 3. КАЧЕСТВЕННЫЕ ЕЛИ СТРОГО ЗА КАРТОЙ (ТОЛЬКО MIL BASE И FACTORY)
    if CONFIG.BackgroundTreesEnabled and bgTreeMap then
        bgTreeCount = populateOutsideBackgroundTrees(model, decorFolder)
    end

    print(string.format("[MM2 Winter v10] %s | Елей: %d | Намётов у стен: %d | Перемётов: %d", model.Name, bgTreeCount, wallDriftCount, openWaveCount))
end

-- ================= 7. ЗАПУСК И ОЧИСТКА =================
applyWinterLighting()

table.insert(connections, Lighting.ChildAdded:Connect(function(child)
    if (child:IsA("Sky") and child.Name ~= "WinterSky_Client")
        or (child:IsA("Atmosphere") and child.Name ~= "WinterAtmosphere_Client") then
        task.defer(applyWinterLighting)
    end
end))

for _, child in ipairs(Workspace:GetChildren()) do
    if child:IsA("Model") or child:IsA("Folder") then
        if child.Name == "Lobby"
            or isBackgroundTreeMap(child.Name)
            or child:FindFirstChild("CoinContainer")
            or child:FindFirstChild("Spawns")
            or child:FindFirstChild("Map") then
            task.spawn(snowifyModel, child)
        end
    end
end

table.insert(connections, Workspace.ChildAdded:Connect(function(child)
    if child:IsA("Model") and child ~= rootFolder and not Players:GetPlayerFromCharacter(child) then
        task.delay(1.8, function()
            if child and child.Parent then
                applyWinterLighting()
                snowifyModel(child)
            end
        end)
    end
end))

getgenv().MM2WinterCleanup = function()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)

    for obj, orig in pairs(modifiedParts) do
        if obj and obj.Parent then
            pcall(function()
                obj.Material = orig.Material
                obj.Color = orig.Color
                obj.Reflectance = orig.Reflectance
            end)
        end
    end
    table.clear(modifiedParts)

    for tex, origTrans in pairs(modifiedTextures) do
        if tex and tex.Parent then
            pcall(function() tex.Transparency = origTrans end)
        end
    end
    table.clear(modifiedTextures)

    for _, obj in ipairs(createdObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(createdObjects)

    table.clear(closedMapBoxes)
    if rootFolder and rootFolder.Parent then
        rootFolder:Destroy()
    end
end

