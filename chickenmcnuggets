    local function refreshLocalKnifeMeshes()
        local found = {}
        local count = 0
        local function scanSource(root, mountedSkin)
            if not root then return end
            local list = root:GetDescendants()
            if root:IsA("BasePart") then table.insert(list, 1, root) end
            for _, obj in ipairs(list) do
                if obj:IsA("BasePart") and not (mountedSkin and obj:IsDescendantOf(mountedSkin)) then
                    local mesh = obj:IsA("MeshPart") and obj or obj:FindFirstChildOfClass("SpecialMesh")
                    local id = mesh and meshAssetId(mesh.MeshId)
                    if id then
                        found[id] = true
                        count += 1
                    end
                end
            end
        end
        local character = player.Character
        for _, container in ipairs({character, player:FindFirstChildOfClass("Backpack")}) do
            if not container then continue end
            for _, item in ipairs(container:GetChildren()) do
                if isTool(item, "Knife") then
                    scanSource(item, skins[item] and skins[item].Skin)
                end
            end
        end
        local display = displayedWeapon(character, "Knife")
        if display then
            scanSource(display, skins[display] and skins[display].Skin)
        end
        if count > 0 then localKnifeMeshIds = found end
        lastMeshRefresh = now()
    end

    local function hideDisplayTree(display, record)
        forceHidePart(display, record)
        for _, desc in ipairs(display:GetDescendants()) do
            if desc:IsA("BasePart") then
                forceHidePart(desc, record)
            end
        end
        if not record.DisplayDescHooked then
            record.DisplayDescHooked = true
            record.HideConns = record.HideConns or {}
            table.insert(record.HideConns, display.DescendantAdded:Connect(function(desc)
                if record.Active and desc:IsA("BasePart") then
                    forceHidePart(desc, record)
                end
            end))
        end
    end

    local function syncCharacterSkins()
        if not Runtime.Alive then return end
        local character = player.Character
        local held = {}
        if character then
            for _, tool in ipairs(character:GetChildren()) do
                if isTool(tool, "Knife") then held.Knife = tool end
                if isTool(tool, "Gun") then held.Gun = tool end
            end
        end

        for tool, record in pairs(skins) do
            local current
            if record.VirtualHolster then
                current = State.SkinChanger and character and tool:IsDescendantOf(character)
                    and displayedWeapon(character, record.DisplayKind) == nil
                    and character:FindFirstChildOfClass("Humanoid") ~= nil
            elseif record.DisplayKind then
                local liveDisplay = displayedWeapon(character, record.DisplayKind)
                if liveDisplay == tool then
                    record.MissingSince = nil
                    current = true
                elseif liveDisplay == nil and record.TorsoAnchored and not held[record.DisplayKind]
                    and character and character:FindFirstChildOfClass("Humanoid") ~= nil then
                    record.MissingSince = record.MissingSince or now()
                    current = (now() - record.MissingSince) < 0.12
                else
                    current = false
                end
            else
                current = character and tool.Parent == character and record.Handle:IsDescendantOf(tool)
            end
            if not current then
                resetSkin(tool, record)
            end
        end

        local knifeName, selectedPose = splitKnifeSelection(State.KnifeSkin)
        local knifeHolster = State.SkinChanger and selectedPose or State.SkinKnifeHolster
        local relocateKnife = knifeHolster == "Back" or knifeHolster == "Belt"
        if not character or (not State.SkinChanger and State.WeaponEffect == "Original" and not relocateKnife
            and not needsWeaponAppearance("Knife") and not needsWeaponAppearance("Gun")) then
            return
        end

        for _, kind in ipairs({"Knife", "Gun"}) do
            local display = displayedWeapon(character, kind)
            local name = kind == "Knife" and knifeName or State.GunSkin
            local poses = State.SkinChanger and WeaponPoseModels[name]
            local relocate = kind == "Knife" and relocateKnife
            local actual = display and weaponAttachment(character, kind, display)
            local pose = relocate and knifeHolster or (actual and actual.Name == "KnifeBack" and "Back" or "Belt")
            local definition = poses and (poses[pose] or (not relocate and (poses.Belt or poses.Back)))
            local replaceEffect = (kind == "Knife" or State.SkinGunEffect) and State.WeaponEffect ~= "Original"
            local keepBelt = definition ~= nil
            local visible = display and (keepBelt or (not held[kind] and display.Transparency < 1))

            if not display and keepBelt and held[kind] then
                local preferred = definition.BeltAttachment or (pose == "Back" and "KnifeBack" or "KnifeBelt")
                local attachment = weaponAttachment(character, kind, nil, preferred)
                if attachment and attachment.Parent and attachment.Parent:IsA("BasePart") and not skins[attachment] then
                    local record = {Active = true, DisplayKind = kind, VirtualHolster = true, Handle = attachment.Parent, Hidden = {}, HideConns = {}, Effects = {}}
                    record.Skin = mountSkin(pathFolder, attachment.Parent, name, nil, attachment, true, nil, definition)
                    if replaceEffect then
                        local effectAnchor = record.Skin and record.Skin:FindFirstChildWhichIsA("BasePart") or attachment.Parent
                        mountWeaponEffect(effectAnchor, kind, record, State.WeaponEffect)
                    end
                    skins[attachment] = record
                end
            elseif display and not visible and skins[display] then
                resetSkin(display, skins[display])
            elseif visible and (definition or replaceEffect or relocate or needsWeaponAppearance(kind)) then
                local record = skins[display]
                if record and record.HeldHidden then resetSkin(display, record); record = nil end
                if not record then
                    record = {Active = true, DisplayKind = kind, Handle = display, Hidden = {}, HideConns = {}, Effects = {}}
                    if definition or ((relocate or needsWeaponAppearance(kind)) and display.Archivable) then
                        local preferred = definition and definition.BeltAttachment
                        local fallback
                        if relocate then
                            preferred = knifeHolster == "Back" and "KnifeBack" or "KnifeBelt"
                            local original = weaponAttachment(character, kind, display)
                            if original then fallback = original.WorldCFrame:ToObjectSpace(display.CFrame) end
                        end
                        local attachment = weaponAttachment(character, kind, display, preferred)
                        record.TorsoAnchored = attachment ~= nil and attachment.Parent ~= nil and attachment.Parent:IsA("BasePart")
                        local temporary
                        if not definition then
                            temporary = cloneWeaponAppearance(display)
                        end
                        local fallbackDefinition = temporary and {Kind = kind, Pieces = {
                            {Template = temporary, Relative = CFrame.identity},
                        }}
                        record.Skin = mountSkin(pathFolder, display, definition and name or nil, nil, attachment,
                            true, fallback, definition or fallbackDefinition)
                        if temporary then temporary:Destroy() end
                    end
                    if replaceEffect then
                        local effectAnchor = record.Skin and record.Skin:FindFirstChildWhichIsA("BasePart") or display
                        mountWeaponEffect(effectAnchor, kind, record, State.WeaponEffect)
                    end
                    skins[display] = record
                end
                if record.Skin then
                    hideDisplayTree(display, record)
                end
                if replaceEffect then
                    for _, object in ipairs(display:GetDescendants()) do suppressWeaponEffect(object, record) end
                end
            end
        end

        updateHeldWeaponSkins(character)
    end

    local charConns = {}
    local function disconnectCharacterHooks()
        for _, conn in ipairs(charConns) do conn:Disconnect() end
        table.clear(charConns)
