        sLight.Color = Color3.fromRGB(255, 225, 130)
        sLight.Brightness = 1.6
        sLight.Range = 24
        sLight.Shadows = false
        sLight.Parent = starA
    end
end

local function computePlayableBounds(model)
    local spawnPoints = {}
    local spawnsFolder = model:FindFirstChild("Spawns", true) or model:FindFirstChild("PlayerSpawns", true)
    if spawnsFolder then
        for _, d in ipairs(spawnsFolder:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(spawnPoints, d.Position)
            end
        end
    end

    if #spawnPoints == 0 then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d.Name:lower():find("spawn") then
                table.insert(spawnPoints, d.Position)
            end
        end
    end

    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    local sumY, countY = 0, 0

    if #spawnPoints > 0 then
        for _, pos in ipairs(spawnPoints) do
            minX = math.min(minX, pos.X)
            maxX = math.max(maxX, pos.X)
            minZ = math.min(minZ, pos.Z)
            maxZ = math.max(maxZ, pos.Z)
            sumY += pos.Y
            countY += 1
        end

        local baseY = (sumY / countY) - 3.5
        local pMinX, pMaxX = minX, maxX
        local pMinZ, pMaxZ = minZ, maxZ
        local searchPad = 46

        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") and obj.CanCollide and obj.Transparency < 0.85 and not isCharacterPart(obj) then
                local wx, wy, wz = getWorldSize(obj)
                if wx < 135 and wz < 135 and math.abs(obj.Position.Y - baseY) < 28 then
                    local px, pz = obj.Position.X, obj.Position.Z
                    if px >= (minX - searchPad) and px <= (maxX + searchPad)
                        and pz >= (minZ - searchPad) and pz <= (maxZ + searchPad) then
                        pMinX = math.min(pMinX, px - wx * 0.5)
                        pMaxX = math.max(pMaxX, px + wx * 0.5)
                        pMinZ = math.min(pMinZ, pz - wz * 0.5)
                        pMaxZ = math.max(pMaxZ, pz + wz * 0.5)
                    end
                end
            end
        end

        pMinX = math.max(pMinX, minX - 55)
        pMaxX = math.min(pMaxX, maxX + 55)
        pMinZ = math.max(pMinZ, minZ - 55)
        pMaxZ = math.min(pMaxZ, maxZ + 55)

        return {
            MinX = pMinX,
            MaxX = pMaxX,
            MinZ = pMinZ,
            MaxZ = pMaxZ,
            GroundY = baseY,
        }
    end

    local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
    if ok and cf and size then
        local c = cf.Position
        return {
            MinX = c.X - math.min(size.X * 0.5, 110),
            MaxX = c.X + math.min(size.X * 0.5, 110),
            MinZ = c.Z - math.min(size.Z * 0.5, 110),
            MaxZ = c.Z + math.min(size.Z * 0.5, 110),
            GroundY = c.Y - size.Y * 0.35,
        }
    end
    return nil
end

local function populateOutsideBackgroundTrees(model, decorFolder)
    local bounds = computePlayableBounds(model)
    if not bounds then return 0 end

    local minX, maxX = bounds.MinX, bounds.MaxX
    local minZ, maxZ = bounds.MinZ, bounds.MaxZ
    local groundY = bounds.GroundY

    local candidates = {}
    local spanX = math.max(40, maxX - minX)
    local spanZ = math.max(40, maxZ - minZ)
    local perimeter = 2 * (spanX + spanZ)
    local sampleSteps = math.max(CONFIG.BackgroundTreeCount * 2, 32)
    local stepDist = perimeter / sampleSteps

    local function pushCandidate(x, z, outX, outZ)
        local row = (math.random() < 0.55) and 1 or 2
        local distOut = (row == 1) and math.random(14, 23) or math.random(25, 38)
        local jitterSide = math.random(-5, 5)
        local px = x + outX * distOut + (-outZ) * jitterSide
        local pz = z + outZ * distOut + outX * jitterSide
        table.insert(candidates, {
            X = px,
            Z = pz,
            OutX = outX,
            OutZ = outZ,
            Row = row,
        })
    end

    for x = minX - 10, maxX + 10, stepDist do
        pushCandidate(x, minZ, 0, -1)
        pushCandidate(x, maxZ, 0, 1)
    end
    for z = minZ - 10, maxZ + 10, stepDist do
        pushCandidate(minX, z, -1, 0)
        pushCandidate(maxX, z, 1, 0)
    end

    for i = #candidates, 2, -1 do
        local j = math.random(1, i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end

    local placed = {}
    local count = 0
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    for _, cand in ipairs(candidates) do
        if count >= CONFIG.BackgroundTreeCount then break end

        local tx, tz = cand.X, cand.Z
        local clearSpot = false
        local finalY = groundY - 2.0
        local needsBaseMound = true

        for _ = 1, 3 do
            local insidePlayable = (tx > minX - 10 and tx < maxX + 10 and tz > minZ - 10 and tz < maxZ + 10)
            if not insidePlayable then
                local ignore = { rootFolder }
                if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
                rayParams.FilterDescendantsInstances = ignore

                local hit = Workspace:Raycast(Vector3.new(tx, groundY + 75, tz), Vector3.new(0, -130, 0), rayParams)
                if not hit then
                    finalY = groundY - 2.2
                    needsBaseMound = true
                    clearSpot = true
                    break
                else
                    local hName = hit.Instance.Name:lower()
                    if hName:find("roof") or hName:find("building") or hName:find("wall") or hit.Position.Y > groundY + 14 then
                        tx += cand.OutX * 12
                        tz += cand.OutZ * 12
                    else
                        finalY = hit.Position.Y - 1.2
                        needsBaseMound = false
                        clearSpot = true
                        break
                    end
                end
            else
                tx += cand.OutX * 14
                tz += cand.OutZ * 14
            end
        end

        if clearSpot then
            local pos2D = Vector3.new(tx, 0, tz)
            local tooClose = false
            for _, p in ipairs(placed) do
                if (pos2D - p).Magnitude < CONFIG.MinBgTreeSpacing then
                    tooClose = true
                    break
                end
            end

            if not tooClose then
                local scale = (cand.Row == 2) and (math.random(125, 165) / 100) or (math.random(105, 138) / 100)
                local isFestive = math.random() < CONFIG.FestiveTreeChance
                spawnHighQualityWinterTree(decorFolder, tx, finalY, tz, scale, isFestive, needsBaseMound)
                table.insert(placed, pos2D)
                count += 1
            end
        end
    end

    return count
end

