    local function bindCharacterHooks(character)
        disconnectCharacterHooks()
        if not character or not Runtime.Alive then return end

        local function hookDisplayRef(obj)
            if obj:IsA("ObjectValue") and (obj.Name == "DisplayRefKnife" or obj.Name == "DisplayRefGun") then
                table.insert(charConns, obj.Changed:Connect(syncCharacterSkins))
            end
        end

        for _, child in ipairs(character:GetChildren()) do
            hookDisplayRef(child)
        end

        table.insert(charConns, character.ChildAdded:Connect(function(child)
            hookDisplayRef(child)
            if child:IsA("Tool") or child.Name == "KnifeDisplay" or child.Name == "GunDisplay"
                or child.Name == "DisplayRefKnife" or child.Name == "DisplayRefGun" then
                syncCharacterSkins()
            end
        end))

        table.insert(charConns, character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") or child.Name == "KnifeDisplay" or child.Name == "GunDisplay" then
                syncCharacterSkins()
            end
        end))

        table.insert(charConns, character.DescendantAdded:Connect(function(desc)
            if desc.Name == "KnifeDisplay" or desc.Name == "GunDisplay" then
                syncCharacterSkins()
            end
        end))

        syncCharacterSkins()
        task.defer(refreshLocalKnifeMeshes)
    end

