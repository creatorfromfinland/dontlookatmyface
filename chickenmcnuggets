    local function updateHeldWeaponSkins(character)
        for _, tool in ipairs(character:GetChildren()) do
            local kind = isTool(tool, "Gun") and "Gun" or isTool(tool, "Knife") and "Knife"
            local grip = kind and equippedGrip(character, tool)
            local handle = kind and (grip and grip.Part1 or partOf(tool))
            if handle then
                local previous = skins[tool]
                local gripChanged = previous and ((previous.Handle ~= handle) or (grip ~= nil and previous.Grip ~= grip) or (not previous.Skin and grip ~= nil))
                if gripChanged then
                    resetSkin(tool, previous)
                end
                local name = kind == "Gun" and State.SkinGunHand or splitKnifeSelection(State.KnifeSkin)
                local poses = State.SkinChanger and WeaponPoseModels[name]
                local customHand = poses and poses.Hand
                local waitingForGrip = customHand and not grip
                if not skins[tool] then
                    if waitingForGrip then
                        skins[tool] = {Active = true, Handle = handle, Hidden = {}, HideConns = {}, Effects = {}, ShotConnections = {}}
                    else
                        applyWeaponLook(tool, handle, kind, grip)
                    end
                end
                local record = skins[tool]
                if record then
                    updateGunSupport(record)
                    if not record.PartsHidden then
                        record.PartsHidden = true
                        record.ShotConnections = record.ShotConnections or {}
                        for _, object in ipairs(tool:GetDescendants()) do
                            hideToolObject(object, record, customHand, waitingForGrip, kind)
                        end
                        table.insert(record.ShotConnections, tool.DescendantAdded:Connect(function(object)
                            if skins[tool] == record then
                                hideToolObject(object, record, customHand, waitingForGrip, kind)
                            end
                        end))
                    else
                        for object in pairs(record.Hidden) do
                            if object.Parent and object.LocalTransparencyModifier ~= 1 then
                                object.LocalTransparencyModifier = 1
                            end
                        end
                    end
                end
            end
        end
    end

