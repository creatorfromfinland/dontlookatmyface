local function evoPhaseName(family, index)
    if not EvoNames[family] or type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 4 then return nil end
    return string.format("%s (Phase %d)", EvoNames[family], index)
end

local function normalizeWeaponModelName(name)
    if type(name) ~= "string" or isRemovedStoreModel(name) then return nil end
    local display, id = name:match("^(.-) %[([%w_-]+)%]$")
    if id then
        local family, rarity = id:match("^(%w+)_(%w+)$")
        family = family or id
        if EvoNames[family] == display then
            return evoPhaseName(family, rarity and EvoRarityIndex[rarity] or 1) or name
        end
        return name
    end
    local base, index = name:match("^(.-) %(Phase ([1-4])%)$")
    for _, title in pairs(EvoNames) do
        if base == title and index then return name end
    end
    return nil
end

