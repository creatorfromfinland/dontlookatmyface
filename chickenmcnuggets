local function partOf(object)
    if not object then return nil end
    if object:IsA("BasePart") then return object end
    local handle = object:FindFirstChild("Handle")
    return handle and handle:IsA("BasePart") and handle
        or object:FindFirstChildWhichIsA("BasePart", true)
end

local function hasWeapon(character)
    local parents = {character}
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then table.insert(parents, backpack) end
    for _, parent in ipairs(parents) do
        for _, tool in ipairs(parent:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife", 1, true) or tool:FindFirstChild("KnifeServer")
                    or name:find("gun", 1, true) or name:find("revolver", 1, true)
                    or tool:FindFirstChild("GunServer") then
                    return true
                end
            end
        end
    end
    return false
end

local function restorePickup(root)
    if not pickup then return end
    if pickup.Root.Parent and root == pickup.Root then
        pickup.Root.CFrame = pickup.Origin
        pickup.Root.AssemblyLinearVelocity = Vector3.zero
    end
    pickup = nil
end

game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if processed or game:GetService("UserInputService"):GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.G then Enabled = not Enabled end
end)

RunService.Heartbeat:Connect(function()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not Enabled then
        restorePickup(root)
        return
    end
    if not root or not humanoid or humanoid.Health <= 0 then
        restorePickup(root)
        return
    end
    if pickup and pickup.Root ~= root then restorePickup(root) end
    local handle = partOf(workspace:FindFirstChild("GunDrop", true))
    if hasWeapon(character) or not handle then
        restorePickup(root)
        return
    end
    if not pickup then
        pickup = {Root = root, Origin = root.CFrame, Started = os.clock()}
    end
    if os.clock() - pickup.Started > 1 then
        restorePickup(root)
        return
    end
    root.CFrame = handle.CFrame + Vector3.new(0, 2, 0)
    if type(firetouchinterest) == "function" and root.Parent and handle.Parent then
        pcall(firetouchinterest, root, handle, 0)
        pcall(firetouchinterest, root, handle, 1)
    end
end)
