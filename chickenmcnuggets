local function applyWinterLighting()
    for _, obj in ipairs(createdObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(createdObjects)

    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") or child:IsA("Atmosphere") then
            child:Destroy()
        end
    end

    local sky = Instance.new("Sky")
    sky.Name = "WinterSky_Client"
    sky.CelestialBodiesShown = false
    sky.StarCount = 0
    sky.Parent = Lighting
    table.insert(createdObjects, sky)

    local atmo = Instance.new("Atmosphere")
    atmo.Name = "WinterAtmosphere_Client"
    atmo.Density = CONFIG.AtmosphereDensity
    atmo.Offset = 0.12
    atmo.Color = CONFIG.SkyHorizonColor
    atmo.Decay = CONFIG.SkyUpperDecay
    atmo.Glare = 0
    atmo.Haze = 2.65
    atmo.Parent = Lighting
    table.insert(createdObjects, atmo)

    pcall(function()
        local terrain = Workspace.Terrain
        for _, c in ipairs(terrain:GetChildren()) do
            if c:IsA("Clouds") then c:Destroy() end
        end
        local clouds = Instance.new("Clouds")
        clouds.Name = "WinterClouds_Client"
        clouds.Cover = 0.72
        clouds.Density = 0.65
        clouds.Color = CONFIG.CloudColor
        clouds.Parent = terrain
        table.insert(createdObjects, clouds)
    end)

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "WinterCC_Client"
    cc.TintColor = CONFIG.ColdTint
    cc.Contrast = 0.06
    cc.Saturation = -0.10
    cc.Brightness = 0.02
    cc.Parent = Lighting
    table.insert(createdObjects, cc)

    pcall(function()
        Lighting.ClockTime = CONFIG.WinterClockTime
        Lighting.GeographicLatitude = 58
        Lighting.Brightness = 1.55
        Lighting.Ambient = Color3.fromRGB(115, 140, 175)
        Lighting.OutdoorAmbient = Color3.fromRGB(145, 175, 212)
        Lighting.ColorShift_Top = Color3.fromRGB(165, 200, 240)
        Lighting.EnvironmentDiffuseScale = 0.6
        Lighting.EnvironmentSpecularScale = 0.4
    end)

    pcall(function()
        local terrain = Workspace.Terrain
        terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(238, 246, 255))
        terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(234, 244, 255))
        terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(228, 238, 250))
        terrain:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(224, 235, 248))
        terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(232, 242, 252))
        terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(232, 242, 252))
        terrain:SetMaterialColor(Enum.Material.Concrete, Color3.fromRGB(238, 245, 255))
    end)
end

-- ================= 2. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =================
local function isCharacterPart(obj)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and obj:IsDescendantOf(plr.Character) then
            return true
        end
    end
    return false
end

local function getWorldSize(part)
    local size = part.Size
    local cf = part.CFrame
    local wx = math.abs(cf.XVector.X) * size.X + math.abs(cf.YVector.X) * size.Y + math.abs(cf.ZVector.X) * size.Z
    local wy = math.abs(cf.XVector.Y) * size.X + math.abs(cf.YVector.Y) * size.Y + math.abs(cf.ZVector.Y) * size.Z
    local wz = math.abs(cf.XVector.Z) * size.X + math.abs(cf.YVector.Z) * size.Y + math.abs(cf.ZVector.Z) * size.Z
    return wx, wy, wz
end

local function isBackgroundTreeMap(name)
    local n = name:lower()
    for _, kw in ipairs(BG_TREE_MAP_KEYWORDS) do
        if n:find(kw) then
            return true
        end
    end
    return false
end

local function isSemiOutdoorMapName(name)
    local n = name:lower()
    for _, kw in ipairs(SEMI_OUTDOOR_KEYWORDS) do
        if n:find(kw) then
            return true
        end
    end
    return false
end

local function isClosedMapName(name)
    local n = name:lower()
    if n:find("farmhouse") or isSemiOutdoorMapName(name) then
        return false
    end
    for _, kw in ipairs(CLOSED_MAP_KEYWORDS) do
        if n:find(kw) then
            return true
        end
    end
    return false
end

local function isFoliageName(name)
    local n = name:lower()
    return n:find("leaf") or n:find("leaves") or n:find("bush") or n:find("grass")
        or n:find("pine") or n:find("foliage") or n:find("hedge")
end

local function isWaterName(name)
    local n = name:lower()
    return n:find("water") or n:find("pool") or n:find("pond") or n:find("river") or n:find("fountain")
end

local function isGreenish(color)
    return color.G > color.R * 1.12 and color.G > color.B * 1.12 and color.G > 0.2
end

local function hasNameFromList(obj, list, maxDepth)
    local curr = obj
    for _ = 1, (maxDepth or 4) do
        if not curr or curr == Workspace then break end
        local n = curr.Name:lower()
        for _, bad in ipairs(list) do
            if n:find(bad) then
                return true
            end
        end
        curr = curr.Parent
    end
    return false
end

local function isWallOrVertical(part, wx, wy, wz)
    local n = part.Name:lower()
    if n:find("wall") or n:find("pillar") or n:find("column") or n:find("door")
        or n:find("frame") or n:find("ceiling") or n:find("window") or n:find("glass")
        or n:find("arch") or n:find("beam") or n:find("curtain") or n:find("blind")
        or n:find("partition") or n:find("desk") or n:find("counter") then
        return true
    end

    local minHoriz = math.min(wx, wz)
    if wy >= 3.0 and wy > minHoriz * 1.05 then
        return true
    end
    return false
end

local function isPointOpenToSky(worldPos, maxHeight)
    maxHeight = maxHeight or 150
    local ignoreList = { rootFolder }
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    for _ = 1, 8 do
        params.FilterDescendantsInstances = ignoreList
        local result = Workspace:Raycast(worldPos + Vector3.new(0, 0.7, 0), Vector3.new(0, maxHeight, 0), params)
        if not result then
            return true
        end

        local hit = result.Instance
        local hName = hit.Name:lower()
        local isGlass = hit.Material == Enum.Material.Glass or hName:find("glass") or hName:find("window")
        local isInvisibleBarrier = (not isGlass) and (hit.Transparency >= 0.85)

        if isCharacterPart(hit) or isFoliageName(hit.Name) or isInvisibleBarrier then
            table.insert(ignoreList, hit)
        else
            return false
        end
    end
    return false
end

local function isPartOutdoorsWorld(part, wx, wy, wz, minOpenPoints)
    minOpenPoints = minOpenPoints or 2
    local pos = part.Position
    local topY = pos.Y + (wy * 0.5)

    if wx < 6 and wz < 6 then
        return isPointOpenToSky(Vector3.new(pos.X, topY, pos.Z), 150)
    end

    local ox = wx * 0.30
    local oz = wz * 0.30
    local samplePoints = {
        Vector3.new(pos.X, topY, pos.Z),
        Vector3.new(pos.X + ox, topY, pos.Z + oz),
        Vector3.new(pos.X - ox, topY, pos.Z + oz),
        Vector3.new(pos.X + ox, topY, pos.Z - oz),
        Vector3.new(pos.X - ox, topY, pos.Z - oz),
    }

    local openCount = 0
    for _, wp in ipairs(samplePoints) do
        if isPointOpenToSky(wp, 150) then
            openCount += 1
            if openCount >= minOpenPoints then
                return true
            end
        end
    end
    return false
end

local function isPosInClosedMap(pos)
    for model, box in pairs(closedMapBoxes) do
        if model and model.Parent then
            local rel = box.CFrame:PointToObjectSpace(pos)
            if math.abs(rel.X) <= (box.Size.X * 0.5 + 6)
                and math.abs(rel.Y) <= (box.Size.Y * 0.5 + 6)
                and math.abs(rel.Z) <= (box.Size.Z * 0.5 + 6) then
                return true
            end
        else
            closedMapBoxes[model] = nil
        end
    end
    return false
end

local function isCameraOutdoors(camPos)
    if isPosInClosedMap(camPos) then
        return false
    end

    if not isPointOpenToSky(camPos, 170) then
        return false
    end

    local openCount = 1
    local offsets = {
        Vector3.new(3.2, 0, 0),
        Vector3.new(-3.2, 0, 0),
        Vector3.new(0, 0, 3.2),
        Vector3.new(0, 0, -3.2),
    }
    for _, off in ipairs(offsets) do
        if isPointOpenToSky(camPos + off, 170) then
            openCount += 1
        end
    end
    return openCount >= 3
end

